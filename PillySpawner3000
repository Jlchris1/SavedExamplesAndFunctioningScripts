local function clearPlayerThreat(userId)
	RecentPlayerThreats[userId] = nil
end

local function cleanupCombatTool(tool)
	if tool and tool.Parent then
		tool:Destroy()
	end
end

local function ensureAnimator(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	return animator
end

local function setVillagerWeaponGrip(tool)
	local name = string.lower(tool.Name)
	if string.find(name, "rocketlauncher", 1, true) or string.find(name, "rocket_launcher", 1, true) or string.find(name, "rocket launcher", 1, true) then
		tool.Grip = CFrame.new(0, -0.15, -1.2) * CFrame.Angles(math.rad(-90), math.rad(90), 0)
	elseif string.find(name, "shotgun", 1, true) then
		tool.Grip = CFrame.new(0, -0.1, -1.1) * CFrame.Angles(math.rad(-90), math.rad(90), 0)
	elseif string.find(name, "classicsword", 1, true) or string.find(name, "machete", 1, true) then
		tool.Grip = CFrame.new(0, 0, -1.7, 0, 0, 1, 1, 0, 0, 0, 1, 0)
	end
end

local function loadTrack(animator, id, looped, priority)
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. tostring(id)
	local track = animator:LoadAnimation(anim)
	track.Looped = looped and true or false
	if priority then
		track.Priority = priority
	end
	return track
end

local function stopTrack(track, fadeTime)
	if track and track.IsPlaying then
		pcall(function()
			track:Stop(fadeTime or 0.15)
		end)
	end
end

local function playTrack(track, fadeTime)
	if track and not track.IsPlaying then
		pcall(function()
			track:Play(fadeTime or 0.15)
		end)
	end
end

local function setupVillagerAnimations(model, villagerId)
	local data = Villagers[villagerId]
	if not data or not model or not model.Parent then
		return
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	local animator = ensureAnimator(humanoid)
	local rigKey = (humanoid.RigType == Enum.HumanoidRigType.R6) and "R6" or "R15"
	local ids = DEFAULT_ANIM_IDS[rigKey]

	local state = {
		idle1 = loadTrack(animator, ids.idle1, true, Enum.AnimationPriority.Idle),
		idle2 = loadTrack(animator, ids.idle2, true, Enum.AnimationPriority.Idle),
		walk = loadTrack(animator, ids.walk, true, Enum.AnimationPriority.Movement),
		run = loadTrack(animator, ids.run, true, Enum.AnimationPriority.Movement),
		jump = loadTrack(animator, ids.jump, false, Enum.AnimationPriority.Action),
		fall = loadTrack(animator, ids.fall, true, Enum.AnimationPriority.Action),
		climb = loadTrack(animator, ids.climb, true, Enum.AnimationPriority.Action),
		swim = loadTrack(animator, ids.swim, true, Enum.AnimationPriority.Movement),
		swimidle = loadTrack(animator, ids.swimidle, true, Enum.AnimationPriority.Idle),
		toolhold = loadTrack(animator, ids.toolhold, true, Enum.AnimationPriority.Action),
		connections = {},
		currentMove = nil,
		currentOverlay = nil,
	}

	data.AnimationState = state

	local function setMove(name)
		if state.currentMove == name then
			return
		end

		state.currentMove = name
		stopTrack(state.idle1, 0.15)
		stopTrack(state.idle2, 0.15)
		stopTrack(state.walk, 0.15)
		stopTrack(state.run, 0.15)
		stopTrack(state.swim, 0.15)
		stopTrack(state.swimidle, 0.15)

		if name == "idle" then
			if math.random(1, 2) == 1 then
				playTrack(state.idle1, 0.15)
				stopTrack(state.idle2, 0.15)
			else
				playTrack(state.idle2, 0.15)
				stopTrack(state.idle1, 0.15)
			end
		elseif name == "walk" then
			playTrack(state.walk, 0.15)
		elseif name == "run" then
			playTrack(state.run, 0.15)
		elseif name == "swim" then
			playTrack(state.swim, 0.15)
		elseif name == "swimidle" then
			playTrack(state.swimidle, 0.15)
		end
	end

	local function setOverlay(name)
		if state.currentOverlay == name then
			return
		end

		if state.currentOverlay == "jump" then
			stopTrack(state.jump, 0.1)
		elseif state.currentOverlay == "fall" then
			stopTrack(state.fall, 0.1)
		elseif state.currentOverlay == "climb" then
			stopTrack(state.climb, 0.1)
		end

		state.currentOverlay = name

		if name == "jump" then
			playTrack(state.jump, 0.05)
		elseif name == "fall" then
			playTrack(state.fall, 0.1)
		elseif name == "climb" then
			playTrack(state.climb, 0.1)
		end
	end

	table.insert(state.connections, humanoid.Running:Connect(function(speed)
		if not data.Alive or not model.Parent then
			return
		end

		local currentState = humanoid:GetState()
		if currentState == Enum.HumanoidStateType.Swimming then
			if speed > 1 then
				setMove("swim")
			else
				setMove("swimidle")
			end
			return
		end
		if currentState == Enum.HumanoidStateType.Climbing then
			setOverlay("climb")
			return
		end
		if currentState == Enum.HumanoidStateType.Freefall then
			setOverlay("fall")
			return
		end

		if speed > 0.5 then
			if speed > 12 then
				setMove("run")
			else
				setMove("walk")
			end
		else
			setMove("idle")
		end
	end))

	table.insert(state.connections, humanoid.StateChanged:Connect(function(_, newState)
		if not data.Alive or not model.Parent then
			return
		end

		if newState == Enum.HumanoidStateType.Jumping then
			setOverlay("jump")
		elseif newState == Enum.HumanoidStateType.Freefall then
			setOverlay("fall")
		elseif newState == Enum.HumanoidStateType.Climbing then
			setOverlay("climb")
		elseif newState == Enum.HumanoidStateType.Swimming then
			setMove("swimidle")
		elseif newState == Enum.HumanoidStateType.Landed then
			setOverlay(nil)
		end
	end))

	table.insert(state.connections, humanoid.Jumping:Connect(function(active)
		if active then
			setOverlay("jump")
		end
	end))

	setMove("idle")
end

local function playVillagerToolPose(villagerId, enabled)
	local data = Villagers[villagerId]
	if not data or not data.AnimationState then
		return
	end

	local state = data.AnimationState
	if enabled then
		playTrack(state.toolhold, 0.12)
	else
		stopTrack(state.toolhold, 0.12)
	end
end

local function clearVillagerCombatWeapon(villagerId)
	local data = Villagers[villagerId]
	if not data then
		return
	end
	if data.CurrentCombatWeapon then
		cleanupCombatTool(data.CurrentCombatWeapon)
		data.CurrentCombatWeapon = nil
	end
end

local function equipWeaponToVillager(model, villagerId)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil, nil
	end

	local template = getRandomVillagerWeapon()
	if not template then
		return nil, nil
	end

	local weapon = template:Clone()
	weapon.CanBeDropped = false
	weapon.Enabled = true
	weapon.ManualActivationOnly = false
	setVillagerWeaponGrip(weapon)
	weapon.Parent = model

	pcall(function()
		humanoid:EquipTool(weapon)
	end)

	playVillagerToolPose(villagerId, true)
	task.wait(WEAPON_EQUIP_DELAY)

	return weapon, getWeaponMode(weapon.Name)
end

local function applyDeathSplashPhysics(model)
	if not model or not model.Parent then
		return
	end

	local root = getModelRootPart(model)
	local center = root and root.Position or Vector3.new()

	for _, inst in ipairs(model:GetDescendants()) do
		if inst:IsA("BasePart") then
			inst.CanCollide = true
			inst.CanTouch = true
			inst.CanQuery = true
			inst.Massless = false

			local offset = inst.Position - center
			if offset.Magnitude < 0.05 then
				offset = Vector3.new(math.random() - 0.5, 0.25, math.random() - 0.5)
			end

			local dir = offset.Unit
			inst.AssemblyLinearVelocity = dir * THROW_SPLASH_VELOCITY + Vector3.new(0, 20, 0)
			inst.AssemblyAngularVelocity = Vector3.new(
				math.random(-10, 10),
				math.random(-10, 10),
				math.random(-10, 10)
			)
		end
	end

	pcall(function()
		model:BreakJoints()
	end)
end

local function destroyVillager(villagerId)
	local data = Villagers[villagerId]
	if not data then
		return
	end

	data.Alive = false

	if data.ThrowMonitorToken then
		data.ThrowMonitorToken = nil
	end

	if data.AnimationState and data.AnimationState.connections then
		for _, conn in ipairs(data.AnimationState.connections) do
			if conn then
				conn:Disconnect()
			end
		end
	end

	clearVillagerCombatWeapon(villagerId)
	playVillagerToolPose(villagerId, false)

	if data.CarriedBy then
		local state = CarryStateByPlayer[data.CarriedBy]
		if state and state.VillagerId == villagerId and state.Tool and state.Tool.Parent then
			state.Tool:Destroy()
		end
		CarryStateByPlayer[data.CarriedBy] = nil
	end

	if data.Model and data.Model.Parent then
		data.Model:Destroy()
	end

	Villagers[villagerId] = nil

	for i = #VillagerOrder, 1, -1 do
		if VillagerOrder[i] == villagerId then
			table.remove(VillagerOrder, i)
			if MovementCursor > #VillagerOrder then
				MovementCursor = 1
			end
			break
		end
	end
end

local function resolveCombatTarget(targetModel)
	local chaosPlayer = getCivilChaosTargetPlayer()
	if chaosPlayer and chaosPlayer.Character then
		return chaosPlayer.Character
	end
	return targetModel
end

startSupportBurst = function(centerPosition, targetModel)
	for villagerId, data in pairs(Villagers) do
		if data.Alive and data.Model and data.Model.Parent and not data.CarriedBy and not data.IsBaby then
			local hrp = getModelRootPart(data.Model)
			if hrp and (hrp.Position - centerPosition).Magnitude <= RETALIATE_RADIUS then
				startAttackLoop(villagerId, targetModel, nil, false)
			end
		end
	end
end

startAttackLoop = function(villagerId, targetModel, forcedMode, force)
	targetModel = resolveCombatTarget(targetModel)

	local data = Villagers[villagerId]
	if not data or not data.Alive or not data.Model or not data.Model.Parent then
		return
	end

	if data.IsBaby then
		return
	end

	local targetPlayer = Players:GetPlayerFromCharacter(targetModel)
	if targetPlayer then
		local targetRep = ReputationService.Get(targetPlayer) or 0
		if targetRep >= 0 and not isChaosActive() then
			return
		end

		pcall(function()
			ReputationService.MarkVillagerAggro(targetPlayer)
		end)
	end

	if data.Busy and data.CurrentCombatTarget == targetModel then
		return
	end

	if data.Busy and not force then
		return
	end

	data.Busy = true
	data.CombatToken = (data.CombatToken or 0) + 1
	data.CurrentCombatTarget = targetModel

	local combatToken = data.CombatToken

	task.spawn(function()
		local model = data.Model
		local humanoid = model and model:FindFirstChildOfClass("Humanoid")
		if not model or not humanoid then
			if Villagers[villagerId] and Villagers[villagerId].CombatToken == combatToken then
				Villagers[villagerId].Busy = false
				Villagers[villagerId].CurrentCombatTarget = nil
			end
			return
		end

		clearVillagerCombatWeapon(villagerId)

		local weapon, mode = equipWeaponToVillager(model, villagerId)
		mode = forcedMode or mode or "generic"
		if not weapon then
			mode = forcedMode or "generic"
		end

		data.CurrentCombatWeapon = weapon
		setCombatHumanoidStats(humanoid)

		local attackStart = os.clock()
		local lastFire = 0
		local lastJump = 0
		local lastMove = 0

		while data.Alive and model.Parent and data.CombatToken == combatToken do
			local targetHumanoid = targetModel and targetModel:FindFirstChildOfClass("Humanoid")
			local targetHrp = targetModel and getModelRootPart(targetModel)

			if not targetHumanoid or not targetHrp or targetHumanoid.Health <= 0 then
				break
			end

			local hrp = getModelRootPart(model)
			if not hrp then
				break
			end

			local dist = (targetHrp.Position - hrp.Position).Magnitude

			if mode == "shotgun" then
				local away = (hrp.Position - targetHrp.Position)
				if away.Magnitude < 0.1 then
					away = Vector3.new(1, 0, 0)
				end
				if dist < 60 and os.clock() - lastMove > 0.35 then
					humanoid:MoveTo(hrp.Position + away.Unit * 18)
					lastMove = os.clock()
				end
				if os.clock() - lastJump > 0.6 then
					humanoid.Jump = true
					lastJump = os.clock()
				end
				if dist <= 120 and os.clock() - lastFire > 1.1 then
					if weapon then
						pcall(function()
							weapon:Activate()
						end)
					end
					lastFire = os.clock()
				end

			elseif mode == "rocketlauncher" then
				local away = (hrp.Position - targetHrp.Position)
				if away.Magnitude < 0.1 then
					away = Vector3.new(1, 0, 0)
				end

				local safeDistance = 95
				local retreatDistance = 130

				if dist < retreatDistance and os.clock() - lastMove > 0.25 then
					humanoid:MoveTo(hrp.Position + away.Unit * 28)
					lastMove = os.clock()
				end

				if os.clock() - lastJump > 0.75 then
					humanoid.Jump = true
					lastJump = os.clock()
				end

				if dist >= safeDistance and os.clock() - lastFire > 1.3 then
					if weapon then
						pcall(function()
							weapon:Activate()
						end)
					end
					lastFire = os.clock()
				end

			elseif mode == "classicsword" or mode == "machete" then
				if dist > 8 and os.clock() - lastMove > 0.25 then
					humanoid:MoveTo(targetHrp.Position)
					lastMove = os.clock()
				end
				if os.clock() - lastFire > 0.3 then
					if weapon then
						pcall(function()
							weapon:Activate()
						end)
					end
					lastFire = os.clock()
				end

			else
				if dist > 10 and os.clock() - lastMove > 0.35 then
					humanoid:MoveTo(targetHrp.Position)
					lastMove = os.clock()
				end
				if os.clock() - lastFire > 0.65 then
					if weapon then
						pcall(function()
							weapon:Activate()
						end)
					end
					lastFire = os.clock()
				end
			end

			task.wait(0.25)
			if os.clock() - attackStart > COMBAT_MAX_DURATION then
				break
			end
		end

		playVillagerToolPose(villagerId, false)

		if weapon then
			cleanupCombatTool(weapon)
		end

		if Villagers[villagerId] and Villagers[villagerId].CombatToken == combatToken then
			Villagers[villagerId].Busy = false
			Villagers[villagerId].CurrentCombatTarget = nil
			Villagers[villagerId].CurrentCombatWeapon = nil
		end
	end)
end

local function chooseRetaliationPlayer(deathPosition, villagerId)
	local chaosPlayer = getCivilChaosTargetPlayer()
	if chaosPlayer then
		return chaosPlayer, 100
	end

	local bestPlayer = nil
	local bestScore = 0

	for userId, threat in pairs(RecentPlayerThreats) do
		if os.clock() - threat.Time <= THREAT_WINDOW then
			local player = Players:GetPlayerByUserId(userId)
			if player and player.Character then
				local charHrp = getCharacterRoot(player.Character)
				if charHrp then
					local score = 0
					if threat.VillagerId == villagerId then
						score += 6
					end
					if threat.VillagerPosition and (threat.VillagerPosition - deathPosition).Magnitude <= 40 then
						score += 4
					end
					if (charHrp.Position - deathPosition).Magnitude <= 120 then
						score += 2
					end
					if score > bestScore then
						bestScore = score
						bestPlayer = player
					end
				end
			end
		end
	end

	return bestPlayer, bestScore
end

onVillagerKilled = function(villagerId)
	local data = Villagers[villagerId]
	if not data or not data.Model then
		return
	end

	local rootPart = getModelRootPart(data.Model)
	local deathPosition = rootPart and rootPart.Position or Vector3.new()
	local player, score = chooseRetaliationPlayer(deathPosition, villagerId)

	if player and not data.SuppressKillRegistration then
		pcall(function()
			ReputationService.RegisterVillagerKill(player)
		end)
	end

	if player and score > 0 and player.Character then
		startSupportBurst(deathPosition, player.Character)
	end
end

local function queueDeathCleanup(villagerId)
	local data = Villagers[villagerId]
	if not data or data.DeathQueued then
		return
	end

	data.DeathQueued = true
	task.delay(DEATH_DESPAWN_DELAY, function()
		local current = Villagers[villagerId]
		if not current or not current.Model then
			return
		end

		local humanoid = current.Model:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			current.DeathQueued = false
			return
		end

		applyDeathSplashPhysics(current.Model)
		onVillagerKilled(villagerId)
		destroyVillager(villagerId)
	end)
end

local function createVillagerName(villagerType)
	if villagerType == "baby" then
		return "Baby Villager " .. BABY_NAMES[math.random(1, #BABY_NAMES)]
	elseif villagerType == "child" then
		return "Child Villager " .. MALE_NAMES[math.random(1, #MALE_NAMES)]
	else
		local namePool = (math.random(1, 2) == 1) and FEMALE_NAMES or MALE_NAMES
		return "Villager " .. namePool[math.random(1, #namePool)]
	end
end

local function pickVillagerType()
	local roll = math.random()
	if roll < BABY_SPAWN_CHANCE then
		return "baby"
	elseif roll < BABY_SPAWN_CHANCE + CHILD_SPAWN_CHANCE then
		return "child"
	else
		return "adult"
	end
end

