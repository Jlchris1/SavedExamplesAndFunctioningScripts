			holdSession += 1
			local session = holdSession

			holding = true
			holdStartCFrame = getHRP() and getHRP().CFrame or nil
			holdCenter = getHRP() and getHRP().Position or nil
			holdRadius = 8
			currentCaught = {}

			createHoldVisual()
			updateUI()

			task.spawn(function()
				local start = os.clock()
				local lastUpdate = 0

				while holding and holdSession == session do
					local hrp = getHRP()
					if not hrp or not hrp.Parent then
						break
					end

					local elapsed = os.clock() - start
					local alpha = math.clamp(elapsed / HOLD_MAX_TIME, 0, 1)
					local eased = alpha ^ 2.25
					local radius = math.max(8, HOLD_MAX_RADIUS * eased)
					local spherePos = hrp.Position

					holdCenter = spherePos
					holdRadius = radius
					updateHoldVisual(spherePos, radius)

					if elapsed - lastUpdate >= HOLD_UPDATE_DT then
						lastUpdate = elapsed

						local caught = getNPCsWithinRadius(spherePos, radius)
						local newCaught = {}

						for _, model in ipairs(caught) do
							newCaught[model] = true
						end

						currentCaught = newCaught

						for model in pairs(caughtHighlights) do
							if not newCaught[model] then
								setCaughtHighlight(model, false)
							end
						end

						for model in pairs(newCaught) do
							setCaughtHighlight(model, true)
							setNPCSlow(model, spherePos, radius)
						end

						for hum, original in pairs(trackedWalkSpeeds) do
							local m = hum and hum.Parent
							if not m or not newCaught[m] or hum.Health <= 0 then
								if hum and hum.Parent then
									pcall(function()
										hum.WalkSpeed = original
									end)
								end
								trackedWalkSpeeds[hum] = nil
							end
						end

						updateHoldOverlay(radius, #caught)
					end

					RunService.Heartbeat:Wait()
				end
			end)
		end
	end)

	holdButton.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		if not holding then
			return
		end

		holding = false
		releasing = true
		updateUI()

		task.spawn(function()
			local hrp = getHRP()
			if not hrp then
				restoreTrackedSpeeds()
				clearCaughtHighlights()
				fadeAndDestroyHoldVisual()
				releasing = false
				updateUI()
				return
			end

			local snapshotMap = {}

			-- Freeze exactly what was already caught at release time.
			for model in pairs(currentCaught) do
				if model and model.Parent then
					snapshotMap[model] = true
				end
			end

			-- Final capture pass so even one NPC is not missed out.
			local finalCenter = holdCenter or hrp.Position
			local finalRadius = holdRadius
			for _, model in ipairs(getNPCsWithinRadius(finalCenter, finalRadius)) do
				if model and model.Parent then
					snapshotMap[model] = true
				end
			end

			local snapshotModels = {}
			for model in pairs(snapshotMap) do
				table.insert(snapshotModels, model)
			end

			table.sort(snapshotModels, function(a, b)
				local ar = getRootPart(a)
				local br = getRootPart(b)
				local localRoot = getHRP()
				local p = localRoot and localRoot.Position or Vector3.new(0, 0, 0)
				local ad = ar and (ar.Position - p).Magnitude or math.huge
				local bd = br and (br.Position - p).Magnitude or math.huge
				return ad < bd
			end)

			finalizeRelease(snapshotModels)
		end)
	end)

	updateUI()
	updateUIScale()

	if Workspace.CurrentCamera then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateUIScale)
	end
end

local function createGuiIfNeeded()
	if gui and gui.Parent then
		return
	end
	createHoldGui()
end

local function wireTool(tool)
	if not tool or not tool:IsA("Tool") then
		return
	end
	if tool:FindFirstChild(TOOL_MARKER) then
		return
	end

	local marker = Instance.new("BoolValue")
	marker.Name = TOOL_MARKER
	marker.Parent = tool

	tool.Equipped:Connect(function(m)
		equipped = true
		mouse = m or localPlayer:GetMouse()
		createGuiIfNeeded()
		updateUI()
	end)

	tool.Unequipped:Connect(function()
		equipped = false
		if holding then
			holding = false
		end
		if not releasing then
			clearCaughtHighlights()
			restoreTrackedSpeeds()
			destroyHoldVisual()
		end
		updateUI()
	end)

	tool.Activated:Connect(function()
		if equipped and not holding and not releasing then
			orbBlast()
		end
	end)
end

local function ensureOnRespawn()
	task.wait(0.1)
	local tool = ensureTool()
	if tool then
		toolInstance = tool
		wireTool(tool)
	end
end

toolInstance = ensureTool()
if toolInstance then
	wireTool(toolInstance)
end

localPlayer.CharacterAdded:Connect(function()
	ensureOnRespawn()
end)

task.spawn(function()
	while true do
		local tool = ensureTool()
		if tool and tool ~= toolInstance then
			toolInstance = tool
			wireTool(tool)
		end
		task.wait(1)
	end
end)

