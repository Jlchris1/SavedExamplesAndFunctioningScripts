	dustEmitter.Color = ColorSequence.new(Color3.fromRGB(92, 66, 39), Color3.fromRGB(130, 95, 60))
	dustEmitter.LightEmission = 0
	dustEmitter.LightInfluence = 0
	dustEmitter.LockedToPart = true
	dustEmitter.Rate = 180
	dustEmitter.Lifetime = NumberRange.new(1.2, 2.0)
	dustEmitter.Speed = NumberRange.new(1.0, 4.0)
	dustEmitter.SpreadAngle = Vector2.new(180, 180)
	dustEmitter.Rotation = NumberRange.new(0, 360)
	dustEmitter.RotSpeed = NumberRange.new(-100, 100)
	dustEmitter.Drag = 6
	dustEmitter.Acceleration = Vector3.new(0, 1.2, 0)
	dustEmitter.EmissionDirection = Enum.NormalId.Top
	dustEmitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 12),
		NumberSequenceKeypoint.new(1, 18),
	})
	dustEmitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.12),
		NumberSequenceKeypoint.new(1, 1),
	})
	dustEmitter.Parent = dustAttachment

	local topCloudPlates = makeCloudPlates(model)

	local segments = table.create(segmentCount)
	local segmentWorldPositions = table.create(segmentCount)
