end

local function resolvePlayerFromValue(value)
	if not value then
		return nil
	end

	if typeof(value) == "Instance" and value:IsA("Player") then
		return value
	end

	if type(value) == "number" then
		return Players:GetPlayerByUserId(value)
	end

	if type(value) == "string" then
		local userId = tonumber(value)
		if userId then
			return Players:GetPlayerByUserId(userId)
		end
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Name == value then
				return player
			end
		end
	end

	return nil
end

local function getPriorityRepTarget()
	local worstPlayer = nil
	local worstRep = 0

	for _, player in ipairs(Players:GetPlayers()) do
		local rep = ReputationService.Get(player) or 0
		if rep < 0 and rep < worstRep then
			worstRep = rep
			worstPlayer = player
		end
	end

	return worstPlayer, worstRep
end

local function getCivilChaosTargetPlayer()
	if not isChaosActive() then
		return nil
	end

	local mods = getChaosModifiers()
	local keys = {
		"ChaosOwner", "ChaosPlayer", "ChaosTarget", "ChaosResponsible", "ChaosResponsiblePlayer",
		"CivilChaosPlayer", "CivilChaosOwner", "ChaosOwnerUserId", "ChaosPlayerUserId",
		"ChaosTargetUserId", "ChaosResponsibleUserId", "CivilChaosUserId", "CivilChaosOwnerUserId",
		"ResponsibleUserId",
	}

	for _, key in ipairs(keys) do
		local player = resolvePlayerFromValue(mods[key])
		if player then
			return player
		end
	end

	local fallback = select(1, getPriorityRepTarget())
	return fallback
end

