		humanoid.UseJumpPower = true
	end)
	pcall(function()
		humanoid.JumpPower = 50
	end)
end

local function getRandomVillagerWeapon()
	local pool = {}
	for _, inst in ipairs(villagerWeaponsFolder:GetChildren()) do
		if inst:IsA("Tool") then
			table.insert(pool, inst)
		end
	end
	if #pool == 0 then
		return nil
	end
	return pool[math.random(1, #pool)]
end

local function refreshZombieCache()
	local now = os.clock()
	if now - ZombieCache.LastRefresh < ZOMBIE_CACHE_REFRESH then
		return ZombieCache.Models
	end

	table.clear(ZombieCache.Models)
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("Model") and inst.Name == "Zombie" then
			local humanoid = inst:FindFirstChildOfClass("Humanoid")
			local hrp = inst:FindFirstChild("HumanoidRootPart")
			if humanoid and hrp and humanoid.Health > 0 then
				table.insert(ZombieCache.Models, inst)
			end
		end
	end

	ZombieCache.LastRefresh = now
	return ZombieCache.Models
end

local function getNearestZombie(position, radius)
	local zombies = refreshZombieCache()
	local bestZombie = nil
	local bestDistance = radius

	for _, zombie in ipairs(zombies) do
		local hrp = zombie:FindFirstChild("HumanoidRootPart")
		local humanoid = zombie:FindFirstChildOfClass("Humanoid")
		if hrp and humanoid and humanoid.Health > 0 then
			local dist = (hrp.Position - position).Magnitude
			if dist <= bestDistance then
				bestDistance = dist
				bestZombie = zombie
			end
		end
	end

	return bestZombie, bestDistance
end

local function refreshNearbyVillagersCache()
	local now = os.clock()
	if now - NearbyVillagerCache.LastRefresh < VILLAGER_NEAR_CACHE_REFRESH then
		return NearbyVillagerCache.List
	end

	table.clear(NearbyVillagerCache.List)
	for villagerId, data in pairs(Villagers) do
		if data.Alive and data.Model and data.Model.Parent then
			local hrp = getModelRootPart(data.Model)
			if hrp then
				table.insert(NearbyVillagerCache.List, {
					Id = villagerId,
					Root = hrp,
					Model = data.Model,
				})
			end
		end
	end

	NearbyVillagerCache.LastRefresh = now
	return NearbyVillagerCache.List
end

local function findClosestVillagerToPosition(position, maxDistance)
	local villagers = refreshNearbyVillagerCache()
	local bestId = nil
	local bestDist = maxDistance

	for _, entry in ipairs(villagers) do
		local d = (entry.Root.Position - position).Magnitude
		if d <= bestDist then
			bestDist = d
			bestId = entry.Id
		end
	end

	return bestId, bestDist
end

local function markPlayerThreat(player, toolName, mode, villagerId, villagerPosition)
