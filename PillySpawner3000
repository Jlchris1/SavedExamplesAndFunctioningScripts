local function getRoadParts()
	local now = os.clock()
	if now - RoadCache.LastRefresh < ROAD_CACHE_REFRESH and #RoadCache.List > 0 then
		return RoadCache.List
	end

	table.clear(RoadCache.List)
	table.clear(RoadCache.IndexByPart)

	local seen = {}

	local function scan(container)
		if not container then
			return
		end
		for _, inst in ipairs(container:GetDescendants()) do
			if inst:IsA("BasePart") and inst.Name == "SnowWorldMudRoad" and not seen[inst] then
				seen[inst] = true
				table.insert(RoadCache.List, inst)
			end
		end
	end

	local whitelisted = workspace:FindFirstChild("Whitelisted")
	if whitelisted then
		local snowWorld = whitelisted:FindFirstChild("SnowWorld")
		if snowWorld then
			scan(snowWorld:FindFirstChild("MudRoads"))
		end
	end

	scan(workspace)

	table.sort(RoadCache.List, function(a, b)
		return a:GetFullName() < b:GetFullName()
	end)

	for i, road in ipairs(RoadCache.List) do
		RoadCache.IndexByPart[road] = i
	end

	RoadCache.LastRefresh = now
	return RoadCache.List
end

local function randomRoadPart()
	local roads = getRoadParts()
	if #roads == 0 then
		return nil
	end
	return roads[math.random(1, #roads)]
end

local function getDifferentRoadPart(excludePart)
	local roads = getRoadParts()
	if #roads == 0 then
		return nil
	end
	if #roads == 1 then
		return roads[1]
	end

	local excludeIndex = excludePart and RoadCache.IndexByPart[excludePart] or nil
	if excludeIndex then
		local offset = math.random(1, math.min(4, #roads - 1))
		local idx = ((excludeIndex - 1 + offset) % #roads) + 1
		local candidate = roads[idx]
		if candidate ~= excludePart and candidate.Parent then
			return candidate
		end
	end

	local candidates = {}
	for _, road in ipairs(roads) do
		if road ~= excludePart and road.Parent then
			table.insert(candidates, road)
		end
	end

	if #candidates == 0 then
		return roads[math.random(1, #roads)]
	end

	return candidates[math.random(1, #candidates)]
end

