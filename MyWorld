end

local function clearCaughtHighlights()
	for model, hl in pairs(caughtHighlights) do
		if hl and hl.Parent then
			pcall(function()
				hl:Destroy()
			end)
		end
		caughtHighlights[model] = nil
	end
end

local function setCaughtHighlight(model, enabled)
	if enabled then
		if not caughtHighlights[model] then
			local hl = Instance.new("Highlight")
			hl.Name = "MyWorldCaughtHighlight"
			hl.Adornee = model
			hl.FillTransparency = 1
			hl.OutlineTransparency = 0
			hl.OutlineColor = HOLD_HIGHLIGHT_COLOR
			hl.Parent = model
			caughtHighlights[model] = hl
		end
	else
		local hl = caughtHighlights[model]
		if hl then
			pcall(function()
				hl:Destroy()
			end)
			caughtHighlights[model] = nil
		end
	end
end

local function getNPCsWithinRadius(center, radius)
	local list = {}
	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("Humanoid") then
			local model = desc.Parent
			if isNPCModel(model) then
				local root = getRootPart(model)
				if root and root:IsA("BasePart") then
					if (root.Position - center).Magnitude <= radius then
						table.insert(list, model)
					end
				end
			end
		end
	end
	return list
end

local function getPlayerClosestToPoint(point)
	local bestPlayer = nil
	local bestDist = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		local root = char and getRootPart(char)
		if root and root:IsA("BasePart") then
			local d = (root.Position - point).Magnitude
			if d < bestDist then
				bestDist = d
				bestPlayer = plr
			end
		end
	end

	return bestPlayer, bestDist
end

local function clusterNPCs(models, threshold)
	local remaining = {}
	for _, model in ipairs(models) do
		if model and model.Parent then
			remaining[model] = true
		end
	end

	local clusters = {}

	local function rootPos(model)
		local root = getRootPart(model)
		return root and root.Position or nil
	end

	while next(remaining) do
		local seed = next(remaining)
		remaining[seed] = nil

		local cluster = { seed }
		local expanded = true

		while expanded do
			expanded = false
			for model in pairs(remaining) do
				local pos = rootPos(model)
				if pos then
					for _, c in ipairs(cluster) do
						local cPos = rootPos(c)
						if cPos and (pos - cPos).Magnitude <= threshold then
							table.insert(cluster, model)
							remaining[model] = nil
							expanded = true
							break
						end
					end
				end
			end
		end

		table.insert(clusters, cluster)
	end

	table.sort(clusters, function(a, b)
		local function centerOf(cluster)
			local sum = Vector3.new(0, 0, 0)
			local count = 0
			for _, m in ipairs(cluster) do
				local p = rootPos(m)
				if p then
					sum += p
					count += 1
				end
			end
			return count > 0 and (sum / count) or Vector3.new(0, 0, 0)
		end

		local hrp = getHRP()
		local p = hrp and hrp.Position or Vector3.new(0, 0, 0)
		return (centerOf(a) - p).Magnitude < (centerOf(b) - p).Magnitude
	end)

	return clusters
end

