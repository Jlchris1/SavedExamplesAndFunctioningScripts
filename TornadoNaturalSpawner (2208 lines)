end

local function armFallDamage(assemblyRoot, humanoid, characterModel)
	if not assemblyRoot or not assemblyRoot.Parent then
		return
	end
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	local existing = pendingFallDamage[assemblyRoot]
	local expiresAt = os.clock() + FALL_DAMAGE_LIFETIME

	if existing then
		existing.humanoid = humanoid
		existing.characterModel = characterModel or existing.characterModel
		existing.expiresAt = math.max(existing.expiresAt or 0, expiresAt)
		existing.armed = true
	else
		pendingFallDamage[assemblyRoot] = {
			humanoid = humanoid,
			characterModel = characterModel,
			expiresAt = expiresAt,
			armed = true,
		}
	end
end

local function updatePendingFallDamage()
	for assemblyRoot, info in pairs(pendingFallDamage) do
		local humanoid = info.humanoid
		local characterModel = info.characterModel

		if not assemblyRoot or not assemblyRoot.Parent or not humanoid or humanoid.Health <= 0 then
			pendingFallDamage[assemblyRoot] = nil
		else
			local modelToIgnore = characterModel or assemblyRoot:FindFirstAncestorOfClass("Model")
			local groundY = getGroundYAtPosition(assemblyRoot.Position, modelToIgnore)
			if groundY and assemblyRoot.Position.Y <= (groundY + FALL_DAMAGE_GROUND_BUFFER) and assemblyRoot.AssemblyLinearVelocity.Y <= 0 then
				local impactPoint = Vector3.new(assemblyRoot.Position.X, groundY, assemblyRoot.Position.Z)
				pendingFallDamage[assemblyRoot] = nil

				if characterModel then
					setCharacterTornadoFreeze(characterModel, humanoid, false)
					ragdollCharacterOnDeath(characterModel)
				end

				spawnBloodSplatter(impactPoint)
				pcall(function()
					humanoid:ChangeState(Enum.HumanoidStateType.Dead)
				end)
				humanoid.Health = 0
			elseif os.clock() > (info.expiresAt or 0) then
				pendingFallDamage[assemblyRoot] = nil
			end
		end
	end
end

local function sampleTriangular(rng, minVal, modeVal, maxVal)
	minVal = math.min(minVal, maxVal)
	maxVal = math.max(minVal, maxVal)
	modeVal = math.clamp(modeVal, minVal, maxVal)

	local u = rng:NextNumber()
	local c = (modeVal - minVal) / (maxVal - minVal)

	if u < c then
		return minVal + math.sqrt(u * (maxVal - minVal) * (modeVal - minVal))
	end

	return maxVal - math.sqrt((1 - u) * (maxVal - minVal) * (maxVal - modeVal))
end

local function weightedBottomWidth(rng)
	if rng:NextNumber() < 0.78 then
		return sampleTriangular(rng, CONFIG.MinLowWidth, 22, 55)
	end
	return sampleTriangular(rng, 30, 120, CONFIG.MaxLowWidth)
end

local function makeTornadoSettings(rng, isTestStorm)
	if isTestStorm then
		return {
			Mph = 200,
			BottomWidth = sampleTriangular(rng, 10, 35, 120),
			TopWidth = sampleTriangular(rng, 120, 450, CONFIG.MaxTopWidth),
			MoveSpeed = sampleTriangular(rng, 7, 9, 11),
			WindField = sampleTriangular(rng, 160, 200, 320),
			PullZone = sampleTriangular(rng, 90, 140, 220),
			AxisClimb = sampleTriangular(rng, 70, 80, 110),
			Ropeyness = sampleTriangular(rng, 0.45, 0.9, 1.8),
			Lifetime = sampleTriangular(rng, 260, 420, 900),
			HasVortices = true,
			TestStorm = true,
		}
	end

	local lowWidth = weightedBottomWidth(rng)
	local hugeChance = rng:NextNumber() < 0.035
	local windField = hugeChance and sampleTriangular(rng, 260, 700, 2200) or sampleTriangular(rng, 120, CONFIG.AverageWindField, 900)
	local pullZone = math.min(sampleTriangular(rng, 50, 120, windField), windField)

	return {
		Mph = hugeChance and sampleTriangular(rng, 120, 220, 340) or sampleTriangular(rng, 40, 110, 260),
		BottomWidth = lowWidth,
		TopWidth = hugeChance and sampleTriangular(rng, 700, 1400, CONFIG.MaxTopWidth) or math.min(math.max(lowWidth * sampleTriangular(rng, 5, 8, 16), lowWidth * 4), CONFIG.MaxTopWidth),
		MoveSpeed = sampleTriangular(rng, 5, CONFIG.AverageMoveSpeed, 16),
		WindField = windField,
		PullZone = pullZone,
		AxisClimb = sampleTriangular(rng, 45, CONFIG.AverageLiftUp, 140),
		Ropeyness = sampleTriangular(rng, 0.25, 0.75, 2.3),
		Lifetime = sampleTriangular(rng, 180, CONFIG.DefaultLifetime, 1200),
		HasVortices = true,
		TestStorm = false,
	}
end

local function sampleSpawnInterval(rng)
	local minI = CONFIG.SpawnMinInterval
	local maxI = CONFIG.SpawnMaxInterval
	local target = CONFIG.SpawnAverageInterval

	local exponent = ((maxI - minI) / (target - minI)) - 1
	exponent = math.clamp(exponent, 1.5, 12)

	local t = rng:NextNumber() ^ exponent
	return math.clamp(minI + (maxI - minI) * t, minI, maxI)
end

local function getOrCreateSpawnPad()
	local pad = Workspace:FindFirstChild("TornadoSpawnPad")
	if pad and pad:IsA("BasePart") then
		return pad
	end

	pad = Instance.new("Part")
	pad.Name = "TornadoSpawnPad"
	pad.Anchored = true
	pad.CanCollide = false
	pad.CanTouch = false
	pad.CanQuery = false
	pad.Transparency = 1
	pad.Size = Vector3.new(1000, 0.001, 1000)
	pad.CFrame = CFrame.new(0, 0, 0)
