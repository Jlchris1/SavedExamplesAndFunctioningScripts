local function applyReputationDelta(player, delta)
	if not player or not delta or delta == 0 then
		return
	end

	local methods = {
		"AddReputation",
		"AdjustReputation",
		"ModifyReputation",
		"ChangeReputation",
		"AddRep",
		"AdjustRep",
		"ModifyRep",
		"ChangeRep",
		"Add",
		"Adjust",
		"Modify",
	}

	for _, methodName in ipairs(methods) do
		local fn = ReputationService[methodName]
		if type(fn) == "function" then
			local ok = pcall(fn, player, delta)
			if not ok then
				ok = pcall(fn, ReputationService, player, delta)
			end
			if ok then
				return
			end
		end
	end

	local current = 0
	pcall(function()
		current = ReputationService.Get(player) or 0
	end)

	local attr = player:GetAttribute("Reputation")
	if type(attr) ~= "number" then
		attr = current
	end
	player:SetAttribute("Reputation", attr + delta)
end

