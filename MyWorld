local function restoreTrackedSpeeds()
	for hum, original in pairs(trackedWalkSpeeds) do
		if hum and hum.Parent then
			pcall(function()
				hum.WalkSpeed = original
			end)
		end
		trackedWalkSpeeds[hum] = nil
	end
end

local function setNPCSlow(model, center, radius)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = getRootPart(model)
	if not hum or not root or hum.Health <= 0 then
		return
	end

	if trackedWalkSpeeds[hum] == nil then
		trackedWalkSpeeds[hum] = hum.WalkSpeed
	end

	local original = trackedWalkSpeeds[hum] or hum.WalkSpeed
	local dist = (root.Position - center).Magnitude

	local newSpeed = original
	if dist <= 80 then
		newSpeed = 0
	elseif radius <= 80 then
		newSpeed = 0
	else
		local alpha = math.clamp((dist - 80) / math.max(radius - 80, 1), 0, 1)
		newSpeed = original * alpha
	end

	pcall(function()
		hum.WalkSpeed = newSpeed
	end)
end

local function destroyHoldVisual()
	if holdSphereFolder and holdSphereFolder.Parent then
		holdSphereFolder:Destroy()
	end

	holdSphereFolder = nil
	holdVisualRoot = nil
	holdVisualLayers = {}
	holdVisualCore = nil
end

local function fadeAndDestroyHoldVisual()
	for _, obj in ipairs(holdVisualLayers) do
		if obj and obj.Parent and obj:IsA("BasePart") then
			pcall(function()
				TweenService:Create(obj, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Transparency = 1,
				}):Play()
			end)
		end
	end

	if holdVisualCore and holdVisualCore.Parent and holdVisualCore:IsA("BasePart") then
		pcall(function()
			TweenService:Create(holdVisualCore, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Transparency = 1,
			}):Play()
		end)
	end

	task.wait(0.4)
	destroyHoldVisual()
end

local function createHoldVisual()
	destroyHoldVisual()

	holdSphereFolder = Instance.new("Folder")
	holdSphereFolder.Name = "MyWorldHoldFX"
	holdSphereFolder.Parent = Workspace

	local position = holdCenter or (getHRP() and getHRP().Position) or Vector3.new(0, 0, 0)

	holdVisualRoot = Instance.new("Part")
	holdVisualRoot.Name = "HoldVisualRoot"
	holdVisualRoot.Anchored = true
	holdVisualRoot.CanCollide = false
	holdVisualRoot.CanTouch = false
	holdVisualRoot.CanQuery = false
	holdVisualRoot.CastShadow = false
	holdVisualRoot.Transparency = 1
	holdVisualRoot.Size = Vector3.new(1, 1, 1)
	holdVisualRoot.CFrame = CFrame.new(position)
	holdVisualRoot.Parent = holdSphereFolder

	local function newLayer(name, transparency)
		local p = Instance.new("Part")
		p.Name = name
		p.Shape = Enum.PartType.Ball
		p.Anchored = false
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.Material = Enum.Material.ForceField
		p.Color = HOLD_DARK_GRAY
		p.Transparency = transparency
		p.Size = Vector3.new(16, 16, 16)
		p.CFrame = CFrame.new(position)
		p.Parent = holdSphereFolder

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = holdVisualRoot
		weld.Part1 = p
		weld.Parent = p

		return p
	end

	-- The core stays fully transparent, while the shockwave is built from 3 ForceField layers.
	holdVisualCore = Instance.new("Part")
	holdVisualCore.Name = "HoldCore"
	holdVisualCore.Shape = Enum.PartType.Ball
	holdVisualCore.Anchored = false
	holdVisualCore.CanCollide = false
	holdVisualCore.CanTouch = false
	holdVisualCore.CanQuery = false
	holdVisualCore.CastShadow = false
	holdVisualCore.Material = Enum.Material.ForceField
	holdVisualCore.Color = HOLD_DARK_GRAY
	holdVisualCore.Transparency = 1
	holdVisualCore.Size = Vector3.new(14, 14, 14)
	holdVisualCore.CFrame = CFrame.new(position)
	holdVisualCore.Parent = holdSphereFolder

	local coreWeld = Instance.new("WeldConstraint")
	coreWeld.Part0 = holdVisualRoot
	coreWeld.Part1 = holdVisualCore
	coreWeld.Parent = holdVisualCore

	local layer1 = newLayer("Layer1", 0.75)
	local layer2 = newLayer("Layer2", 0.84)
	local layer3 = newLayer("Layer3", 0.91)

	holdVisualLayers = { layer1, layer2, layer3 }
end

local function updateHoldVisual(position, radius)
	if not holdSphereFolder or not holdSphereFolder.Parent then
		return
	end

	if holdVisualRoot and holdVisualRoot.Parent then
		holdVisualRoot.CFrame = CFrame.new(position)
	end

	local base = radius * 2
	local sizes = {
		Vector3.new(base, base, base),
		Vector3.new(base * 0.965, base * 0.965, base * 0.965),
		Vector3.new(base * 0.93, base * 0.93, base * 0.93),
	}

	for i, layer in ipairs(holdVisualLayers) do
		if layer and layer.Parent then
			layer.Size = sizes[i] or sizes[#sizes]
			layer.CFrame = CFrame.new(position)
		end
	end

	if holdVisualCore and holdVisualCore.Parent then
		holdVisualCore.CFrame = CFrame.new(position)
		holdVisualCore.Size = Vector3.new(base * 0.88, base * 0.88, base * 0.88)
	end
end

local function orbBlast()
	local hrp = getHRP()
	if not hrp then
		return
	end

	local blastPos = getAimPosition()

	-- Keep the click explosion behavior the same as before
	local folder = Instance.new("Folder")
	folder.Name = "MyWorldOrbFX"
	folder.Parent = Workspace

	local outer = Instance.new("Part")
	outer.Name = "OuterOrb"
	outer.Shape = Enum.PartType.Ball
	outer.Anchored = true
	outer.CanCollide = false
	outer.CastShadow = false
	outer.Material = Enum.Material.SmoothPlastic
	outer.Color = Color3.fromRGB(34, 34, 34)
	outer.Transparency = 0.15
	outer.Size = Vector3.new(4, 4, 4)
	outer.CFrame = CFrame.new(blastPos)
	outer.Parent = folder

	local inner = Instance.new("Part")
	inner.Name = "InnerNegatedCenter"
	inner.Shape = Enum.PartType.Ball
	inner.Anchored = true
	inner.CanCollide = false
	inner.CastShadow = false
	inner.Material = Enum.Material.SmoothPlastic
	inner.Color = Color3.fromRGB(0, 0, 0)
	inner.Transparency = 0
	inner.Size = Vector3.new(1.5, 1.5, 1.5)
	inner.CFrame = CFrame.new(blastPos)
	inner.Parent = folder

	local expandTween = TweenInfo.new(1.2 * 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local finalSize = Vector3.new(ORB_RADIUS * 2, ORB_RADIUS * 2, ORB_RADIUS * 2)

	TweenService:Create(outer, expandTween, {
		Size = finalSize,
		Transparency = 0.32,
	}):Play()

	TweenService:Create(inner, expandTween, {
		Size = Vector3.new(ORB_RADIUS * 1.44, ORB_RADIUS * 1.44, ORB_RADIUS * 1.44),
		Transparency = 0,
	}):Play()

	task.delay(1.2, function()
		if folder and folder.Parent then
			folder:Destroy()
		end
	end)

	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("Humanoid") then
			local model = desc.Parent
			if isNPCModel(model) then
				local root = getRootPart(model)
				if root and root:IsA("BasePart") then
					local dist = (root.Position - blastPos).Magnitude
					if dist <= ORB_RADIUS then
						local dir = (root.Position - blastPos)
						if dir.Magnitude < 0.001 then
							dir = Vector3.new(0, 1, 0)
						else
							dir = dir.Unit
						end

						pcall(function()
							root.AssemblyLinearVelocity = dir * ORB_BLAST_KNOCKBACK + Vector3.new(0, ORB_BLAST_KNOCKBACK * 0.25, 0)
							root.AssemblyAngularVelocity = Vector3.new(math.random(-15, 15), math.random(-15, 15), math.random(-15, 15))
						end)

						pcall(function()
							desc:TakeDamage(ORB_BLAST_DAMAGE)
						end)
						pcall(function()
							desc.Health = 0
						end)
					end
				end
			end
		end
	end
end

local function forceKillHumanoid(hum)
	if not hum or hum.Health <= 0 then
		return
	end

	pcall(function()
		hum.Health = 0
	end)
	task.wait(0.03)

	if hum.Parent and hum.Health > 0 then
		local maxHealth = hum.MaxHealth > 0 and hum.MaxHealth or 100
		pcall(function()
			hum.Health = math.min(100, maxHealth)
		end)
		task.wait(0.03)
	end

	if hum.Parent and hum.Health > 0 then
		pcall(function()
			hum.Health = 0
		end)
		task.wait(0.03)
	end

	if hum.Parent and hum.Health > 0 then
		pcall(function()
			hum:TakeDamage(9e37)
		end)
		task.wait(0.03)
	end

	if hum.Parent and hum.Health > 0 then
		pcall(function()
			hum.Health = 0
		end)
	end
end

local function groupAliveCount(cluster)
	local alive = 0
	for _, model in ipairs(cluster) do
		if model and model.Parent then
			local hum = model:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				alive += 1
			end
		end
	end
	return alive
end

local function killClusterUntilDead(cluster)
	local startClock = os.clock()

	while true do
		local alive = groupAliveCount(cluster)
		if alive <= 0 then
			return
		end

		local centroid = Vector3.new(0, 0, 0)
		local count = 0
		for _, model in ipairs(cluster) do
			if model and model.Parent then
				local root = getRootPart(model)
				if root then
					centroid += root.Position
					count += 1
				end
			end
		end
		if count > 0 then
			centroid /= count
		else
			centroid = (getHRP() and getHRP().Position) or Vector3.new(0, 0, 0)
		end

		local localRoot = getHRP()
		local localPlayerClosest = getPlayerClosestToPoint(centroid)

		-- If another player is currently closer to the NPC group, move the local player there first.
		if localRoot and localPlayerClosest ~= localPlayer then
			pcall(function()
				localRoot.CFrame = CFrame.new(centroid + Vector3.new(0, 6, 0))
			end)
			task.wait(0.08)
		end

		-- Re-check after teleport and keep focusing this group until every NPC is dead.
		for _, model in ipairs(cluster) do
			if model and model.Parent then
				local hum = model:FindFirstChildOfClass("Humanoid")
				local root = getRootPart(model)
				if hum and root and hum.Health > 0 then
					pcall(function()
						root.AssemblyLinearVelocity = Vector3.new(0, 130, 0)
						root.AssemblyAngularVelocity = Vector3.new(math.random(-15, 15), math.random(-15, 15), math.random(-15, 15))
					end)
					forceKillHumanoid(hum)
				end
			end
		end

		task.wait(0.08)

		-- Keep repeating until the whole group is properly dead.
		if os.clock() - startClock > 120 then
			-- hard safety stop against infinite lockup if a model is unkillable
			return
		end
	end
end

local function finalizeRelease(snapshotModels)
	releasing = true
	updateUI()

	-- Keep the hold sphere active until every captured NPC is dead.
	local releaseClusters = clusterNPCs(snapshotModels, 36)

	for _, cluster in ipairs(releaseClusters) do
		killClusterUntilDead(cluster)
	end

	restoreTrackedSpeeds()
	clearCaughtHighlights()
	fadeAndDestroyHoldVisual()

	releasing = false
	updateUI()

	local returnHRP = getHRP()
	if returnHRP and holdStartCFrame then
		pcall(function()
			returnHRP.CFrame = holdStartCFrame
		end)
	end
end

