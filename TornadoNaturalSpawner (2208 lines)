	dustField.Anchored = true
	dustField.Transparency = 1
	dustField.CanCollide = false
	dustField.CanTouch = false
	dustField.CanQuery = false
	dustField.Size = Vector3.new(1, 1, 1)
	dustField.Parent = model

	local dustAttachment = Instance.new("Attachment")
	dustAttachment.Name = "DustEmitterAttachment"
	dustAttachment.Parent = dustField

