	local visible = equipped
	if topBar then
		topBar.Visible = visible
	end
	if shootButton then
		shootButton.Visible = visible and not releasing
	end
	if holdButton then
		holdButton.Visible = visible and not releasing
	end
	if topLabel then
		topLabel.Visible = visible and (holding or releasing)
	end
	if countLabel then
		countLabel.Visible = visible and (holding or releasing)
