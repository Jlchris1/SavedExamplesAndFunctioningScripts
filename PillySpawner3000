local function getToolStats(tool)
	local out = {}
	local statsFolder = tool:FindFirstChild("Stats")
	if not statsFolder then
		return out
	end
	for _, v in ipairs(statsFolder:GetChildren()) do
		if v:IsA("StringValue") or v:IsA("IntValue") or v:IsA("NumberValue") then
			out[v.Name] = tostring(v.Value)
		end
	end
	return out
end

local function weightForTool(tool)
	local cost = math.max(1, getNumericCost(tool))
	local explicit = getExplicitRarity(tool)

	if explicit == "divine" then return 0.000002 end
	if explicit == "secret" then return 0.00001 end
	if explicit == "mythical" then return 0.00004 end
	if explicit == "legendary" then return 0.0002 end
	if explicit == "epic" then return 0.001 end
	if explicit == "rare" then return 0.005 end
	if explicit == "uncommon" then return 0.04 end

	return 1 / (1 + (cost / 100))
end

local function pickWeightedTool(pool)
	if #pool == 0 then
		return nil
	end

	local total = 0
	for _, tool in ipairs(pool) do
		total += weightForTool(tool)
	end

	local roll = math.random() * math.max(total, 0.000001)
	local running = 0
	for _, tool in ipairs(pool) do
		running += weightForTool(tool)
		if roll <= running then
			return tool
		end
	end

	return pool[#pool]
end

local function rollSlotRarity()
	local r = math.random(1, 500000)
	if r == 1 then
		return "divine"
	elseif r <= 6 then
		return "secret"
	elseif r <= 26 then
		return "mythical"
	elseif r <= 126 then
		return "legendary"
	elseif r <= 626 then
		return "epic"
	elseif r <= 3126 then
		return "rare"
	elseif r <= 22326 then
		return "uncommon"
	else
		return "common"
	end
end

local function isToolEligibleForTier(tool, tier)
	local explicit = getExplicitRarity(tool)
	local cost = getNumericCost(tool)
	local toolTier = explicit or rarityFromCost(cost)
	return RARITY_ORDER[toolTier] and RARITY_ORDER[toolTier] <= RARITY_ORDER[tier]
end

local function buildVillagerItemList()
	local pool = listTradableTools()
	if #pool == 0 then
		return {}
	end

	local slots = math.random(1, MAX_ITEMS_PER_VILLAGER)
	local picked = {}
	local used = {}

	for _ = 1, slots do
		local tier = rollSlotRarity()
		local candidates = {}

		for _, tool in ipairs(pool) do
			if not used[tool] and isToolEligibleForTier(tool, tier) then
				table.insert(candidates, tool)
			end
		end

		if #candidates == 0 then
			for _, tool in ipairs(pool) do
				if not used[tool] then
					table.insert(candidates, tool)
				end
			end
		end

		if #candidates == 0 then
			break
		end

		local chosen = pickWeightedTool(candidates)
		if chosen then
			used[chosen] = true
			local cost = getNumericCost(chosen)
			local rarity = getExplicitRarity(chosen) or rarityFromCost(cost)
			table.insert(picked, {
				Id = HttpService:GenerateGUID(false),
				ToolName = chosen.Name,
				Cost = cost,
				Rarity = rarity,
				Stats = getToolStats(chosen),
			})
		end
	end

	return picked
end

