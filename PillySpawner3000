local function getNumericCost(tool)
	for _, name in ipairs({ "Cost", "Price" }) do
		local found = tool:FindFirstChild(name, true)
		if found and (found:IsA("StringValue") or found:IsA("IntValue") or found:IsA("NumberValue")) then
			return tonumber(found.Value) or 1
		end
	end
	return 1
end

local function getExplicitRarity(tool)
	for _, rarity in ipairs({ "Divine", "Secret", "Mythical", "Legendary" }) do
		if tool:FindFirstChild(rarity, true) then
			return string.lower(rarity)
		end
	end
	return nil
end

local function rarityFromCost(cost)
	if cost >= 1000000 then
		return "divine"
	elseif cost >= 100000 then
		return "secret"
	elseif cost >= 10000 then
		return "mythical"
	elseif cost >= 1000 then
		return "legendary"
	elseif cost >= 401 then
		return "epic"
	elseif cost >= 191 then
		return "rare"
	elseif cost >= 91 then
		return "uncommon"
	else
		return "common"
	end
end

