local function setThrownPlatformStand(villagerId, enabled)
	local data = Villagers[villagerId]
	if not data or not data.Model then
		return
	end
	local humanoid = data.Model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	humanoid.PlatformStand = enabled and true or false
	if enabled then
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end
end

local function calculateImpactDamage(speed, isGround)
	if isGround then
		local extra = math.max(0, speed - 20)
		local damage = THROW_GROUND_BASE_DAMAGE + math.floor(extra * THROW_GROUND_DAMAGE_SCALE)
		return math.clamp(damage, THROW_GROUND_BASE_DAMAGE, 1000)
	end

	local extra = math.max(0, speed - THROW_WALL_KILL_MIN_SPEED)
	local damage = 100 + math.floor(extra * 4)
	return math.clamp(damage, 100, 1000)
end

local function applyThrownGroundDamage(villagerId, player, humanoid, speed, impactPosition)
	local data = Villagers[villagerId]
	if not data or not data.Alive or not humanoid or humanoid.Health <= 0 then
		return
	end

	local damage = calculateImpactDamage(speed, true)
	humanoid:TakeDamage(damage)

	if humanoid.Health <= 0 then
		killVillagerWithImpact(villagerId, player, impactPosition, false, speed)
	end
end

function killVillagerWithImpact(villagerId, player, impactPosition, directWallImpact, speed)
	local data = Villagers[villagerId]
	if not data or not data.Alive or not data.Model or not data.Model.Parent then
		return
	end

	if data.ImpactKilled then
		return
	end
	data.ImpactKilled = true
	data.SuppressKillRegistration = true

	if player then
		applyReputationDelta(player, -150)
		markPlayerThreat(player, "VillagerCarry", directWallImpact and "wall" or "ground", villagerId, impactPosition)
	end

	local humanoid = data.Model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.BreakJointsOnDeath = true
		humanoid.Health = 0
	end

	applyDeathSplashPhysics(data.Model)
	queueDeathCleanup(villagerId)
end

local function releaseCarriedVillager(player, throwIt)
	local state = CarryStateByPlayer[player.UserId]
	if not state then
		return
	end

	CarryStateByPlayer[player.UserId] = nil

	local villagerId = state.VillagerId
	local data = Villagers[villagerId]
	if data then
		data.CarriedBy = nil
		data.Busy = false
	end

	local model = state.Model
	if model and model.Parent then
		local root = getModelRootPart(model)
		local char = player.Character
		local chrp = getCharacterRoot(char)

		if root and chrp then
			root.CFrame = chrp.CFrame * CARRY_FRONT_OFFSET
		end

		for _, inst in ipairs(model:GetDescendants()) do
			if inst:IsA("BasePart") then
				inst.CanCollide = true
				inst.CanTouch = true
				inst.CanQuery = true
				inst.Massless = false
			end
		end

		local weld = model:FindFirstChild("CarryWeld", true)
		if weld then
			weld:Destroy()
		end

		if throwIt and root and chrp then
			local aimPos = state.AimPosition
			local throwDir

			if typeof(aimPos) == "Vector3" then
				throwDir = aimPos - chrp.Position
			end

			if not throwDir or throwDir.Magnitude < 0.1 then
				throwDir = chrp.CFrame.LookVector
			end

			if throwDir.Magnitude < 0.1 then
				throwDir = Vector3.new(0, 0, -1)
			end

			if data and data.Model then
				setThrownPlatformStand(villagerId, true)
				setVillagerThrowHighlight(villagerId, true)

				data.ThrowHighlightToken = (data.ThrowHighlightToken or 0) + 1
				local highlightToken = data.ThrowHighlightToken
				task.delay(THROW_HIGHLIGHT_DURATION, function()
					local current = Villagers[villagerId]
					if current and current.ThrowHighlightToken == highlightToken then
						setVillagerThrowHighlight(villagerId, false)
					end
				end)
			end

			root.AssemblyLinearVelocity = throwDir.Unit * THROW_VELOCITY
			root.AssemblyAngularVelocity = Vector3.new(
				math.random(-10, 10),
				math.random(-10, 10),
				math.random(-10, 10)
			)

			markPlayerThreat(player, "VillagerCarry", "throw", villagerId, root.Position)
			applyReputationDelta(player, -150)

			if data then
				data.ThrowMonitorToken = (data.ThrowMonitorToken or 0) + 1
				local token = data.ThrowMonitorToken

				task.spawn(function()
					local humanoid = model:FindFirstChildOfClass("Humanoid")
					local startTime = os.clock()
					local lastPos = root.Position
					local touchDebounce = false

					local touchedConn
					touchedConn = root.Touched:Connect(function(hit)
						if touchDebounce then
							return
						end
						if not data.Alive or data.ThrowMonitorToken ~= token then
							return
						end
						if not hit or not hit.Parent then
							return
						end
						if player.Character and hit:IsDescendantOf(player.Character) then
							return
						end

						local elapsed = os.clock() - startTime
						if elapsed < THROW_GRACE_TIME then
							return
						end

						local speed = root.AssemblyLinearVelocity.Magnitude
						if speed < 8 then
							return
						end

						local isGround = hit == workspace.Terrain
							or (hit:IsA("BasePart") and math.abs(hit.CFrame.UpVector.Y) > 0.55)

						if not isGround and speed >= THROW_WALL_KILL_MIN_SPEED then
							touchDebounce = true
							killVillagerWithImpact(villagerId, player, root.Position, false, speed)
						elseif isGround then
							touchDebounce = true
							applyThrownGroundDamage(villagerId, player, humanoid, speed, root.Position)
						end
					end)

					while data.Alive and data.Model == model and model.Parent and data.ThrowMonitorToken == token do
						if os.clock() - startTime >= THROW_PLATFORMSTAND_TIME then
							break
						end

						local currentPos = root.Position
						local delta = currentPos - lastPos
						local speed = root.AssemblyLinearVelocity.Magnitude

						if (os.clock() - startTime) >= THROW_GRACE_TIME and delta.Magnitude > 0.05 then
							local params = RaycastParams.new()
							params.FilterType = Enum.RaycastFilterType.Exclude
							params.FilterDescendantsInstances = { model }
							params.IgnoreWater = false

							local result = workspace:Raycast(lastPos, delta, params)
							if result then
								local hit = result.Instance
								local isGround = result.Normal.Y >= 0.55
								if isGround then
									applyThrownGroundDamage(villagerId, player, humanoid, speed, result.Position)
								else
									killVillagerWithImpact(villagerId, player, result.Position, true, speed)
								end
								break
							end
						end

						lastPos = currentPos
						RunService.Heartbeat:Wait()
					end

					if touchedConn then
						touchedConn:Disconnect()
					end

					if data and data.Alive and data.Model == model and data.ThrowMonitorToken == token then
						setThrownPlatformStand(villagerId, false)
						setVillagerThrowHighlight(villagerId, false)
					end
				end)
			end
		end
	end

	if state.Tool and state.Tool.Parent then
		state.Tool:Destroy()
	end
end

local function attachCarryVillager(player, villagerId)
	if CarryStateByPlayer[player.UserId] then
		return false
	end

	local data = Villagers[villagerId]
	if not data or not data.Model or not data.Model.Parent then
		return false
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = getCharacterRoot(character)
	local root = getModelRootPart(data.Model)

	if not humanoid or not hrp or not root then
		return false
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		backpack = player:WaitForChild("Backpack")
	end

	if backpack:FindFirstChild("VillagerCarry") or (character and character:FindFirstChild("VillagerCarry")) then
		return false
	end

	local tool = makeCarryTool()
	tool.Parent = backpack

	local equippedConn
	equippedConn = tool.Equipped:Connect(function()
		local currentData = Villagers[villagerId]
		if not currentData or currentData.CarriedBy or currentData.DeathQueued then
			return
		end

		local char = player.Character
		local chrp = getCharacterRoot(char)
		local model = currentData.Model
		local modelRoot = getModelRootPart(model)
		if not char or not chrp or not modelRoot then
			return
		end

		currentData.CarriedBy = player.UserId
		currentData.Busy = true

		for _, inst in ipairs(model:GetDescendants()) do
			if inst:IsA("BasePart") then
				inst.CanCollide = false
				inst.CanTouch = false
				inst.CanQuery = false
				inst.Massless = true
			end
		end

		modelRoot.CFrame = chrp.CFrame * CARRY_FRONT_OFFSET

		local weld = Instance.new("WeldConstraint")
		weld.Name = "CarryWeld"
		weld.Part0 = modelRoot
		weld.Part1 = chrp
		weld.Parent = modelRoot

		CarryStateByPlayer[player.UserId] = {
			Tool = tool,
			Model = model,
			VillagerId = villagerId,
			Weld = weld,
			AimPosition = nil,
		}
	end)

	tool.AncestryChanged:Connect(function(_, parent)
		if not parent then
			if CarryStateByPlayer[player.UserId] and CarryStateByPlayer[player.UserId].VillagerId == villagerId then
				releaseCarriedVillager(player, false)
			end
			if equippedConn then
				equippedConn:Disconnect()
			end
		end
	end)

	humanoid:EquipTool(tool)
	return true
end

local function monitorVillagerLifetime(villagerId)
	task.spawn(function()
		while true do
			local data = Villagers[villagerId]
			if not data or not data.Alive or not data.Model or not data.Model.Parent then
				return
			end

			if data.DespawnAt and os.clock() >= data.DespawnAt then
				if data.Busy then
					data.DespawnAt = os.clock() + 30
				else
					destroyVillager(villagerId)
					return
				end
			end

			task.wait(3)
		end
	end)
end

local function watchVillagerHealth(model, villagerId)
	task.spawn(function()
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end

		local data = Villagers[villagerId]
		if not data then
			return
		end

		data.LastHealth = humanoid.Health

		while model.Parent and Villagers[villagerId] and Villagers[villagerId].Alive do
			local currentHealth = humanoid.Health
			local previousHealth = data.LastHealth or currentHealth

			if currentHealth < previousHealth then
				local creatorTag = humanoid:FindFirstChild("creator")
				local creatorValue = creatorTag and creatorTag.Value
				local player = getPlayerFromCreatorValue(creatorValue)

				if player and player.Character then
					local equippedMode, equippedTool = getPlayerEquippedToolMode(player)
					if equippedMode == "classicsword" then
						local playerRoot = getCharacterRoot(player.Character)
						if playerRoot then
							local targetId = select(1, findClosestVillagerToPosition(playerRoot.Position, 8))
							if targetId then
								local targetData = Villagers[targetId]
								if targetData and targetData.Alive and targetData.Model and targetData.Model.Parent then
									local targetRoot = getModelRootPart(targetData.Model)
									markPlayerThreat(player, equippedTool and equippedTool.Name or "ClassicSword", equippedMode, targetId, targetRoot and targetRoot.Position or nil)
									startAttackLoop(targetId, player.Character, equippedMode, false)
								end
							end
						end
					end
				end
			end

			data.LastHealth = currentHealth

			if humanoid.Health <= 0 then
				queueDeathCleanup(villagerId)
				break
			end

			task.wait(HEALTH_POLL_INTERVAL)
		end
	end)
end

local function supportOrIgnoreOnMonsterFight(player, toolName, mode)
	if isChaosActive() then
		return false
	end

	local character = player.Character
	local hrp = getCharacterRoot(character)
	if not hrp then
		return false
	end

	local nearbyZombie = getNearestZombie(hrp.Position, MONSTER_ASSIST_RADIUS)
	if nearbyZombie then
		local zombieRoot = getModelRootPart(nearbyZombie)
		if zombieRoot then
			startSupportBurst(zombieRoot.Position, nearbyZombie)
			return true
		end
	end

	return false
end

local function getActiveVillagerCount()
	local count = 0
	for _, data in pairs(Villagers) do
		if data.Alive and data.Model and data.Model.Parent then
			count += 1
		end
	end
	return count
end

local function spawnVillager()
	local templates = getTemplateList()
	if #templates == 0 then
		warn("[VillagerTrade] No models found inside ServerStorage.VillagerTemplates")
		return
	end

	local roads = getRoadParts()
	if #roads == 0 then
		warn("[VillagerTrade] No parts named 'SnowWorldMudRoad' found in Workspace yet.")
		return
	end

	local template = templates[math.random(1, #templates)]
	local model = template:Clone()
	model.Parent = villagerFolder

	ensurePrimaryPart(model)
	if not model.PrimaryPart then
		warn("[VillagerTrade] Template missing HumanoidRootPart / PrimaryPart: " .. model.Name)
		model:Destroy()
		return
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		warn("[VillagerTrade] Villager template missing Humanoid: " .. model.Name)
		model:Destroy()
		return
	end

	local villagerId = HttpService:GenerateGUID(false)
	local villagerType = pickVillagerType()

	model:SetAttribute("VillagerId", villagerId)
	model:SetAttribute("Tradeable", villagerType == "adult")
	model:SetAttribute("IsChild", villagerType == "child")
	model:SetAttribute("IsBaby", villagerType == "baby")
	model:SetAttribute("VillagerType", villagerType)
	model.Name = createVillagerName(villagerType)

	applyVillagerScale(model, villagerType)
	configureVillagerHumanoid(model, villagerType)

	local items = {}
	local itemMap = {}

	if villagerType == "adult" then
		items = buildVillagerItemList()
		setVillagerRarityAttributes(model, items)

		for _, item in ipairs(items) do
			local templateTool = tradablesFolder:FindFirstChild(item.ToolName)
			if templateTool and templateTool:IsA("Tool") then
				itemMap[item.Id] = templateTool
			end
		end
	else
		setVillagerRarityAttributes(model, {})
	end

	local despawnTime = os.clock() + math.random(MIN_LIFETIME, MAX_LIFETIME)

	Villagers[villagerId] = {
		Model = model,
		Items = items,
		ToolMap = itemMap,
		Alive = true,
		Busy = false,
		CombatToken = 0,
		DeathQueued = false,
		CurrentCombatTarget = nil,
		CurrentCombatWeapon = nil,
		AnimationState = nil,
		LastHealth = humanoid.Health,
		DespawnAt = despawnTime,
		CurrentRoad = nil,
		NextMoveAt = os.clock() + math.random(2, 4),
		IsChild = villagerType == "child",
		IsBaby = villagerType == "baby",
		CarriedBy = nil,
		SuppressKillRegistration = false,
		ImpactKilled = false,
		ThrowMonitorToken = 0,
		ThrowHighlightToken = 0,
		ThrowHighlight = nil,
	}

	table.insert(VillagerOrder, villagerId)

	setupVillagerAnimations(model, villagerId)
	watchVillagerHealth(model, villagerId)
	monitorVillagerLifetime(villagerId)
	monitorVillagerDeath(model, villagerId)

	local road = randomRoadPart()
	if road then
		Villagers[villagerId].CurrentRoad = road
		placeOnRoad(model, road)
	end

	local promptTrade
	local promptPickup

	if villagerType == "baby" then
		promptPickup = createPrompt(model, "Pick Up", "Baby Villager", Vector2.new(0, 0))
	elseif villagerType == "child" then
		promptPickup = createPrompt(model, "Pick Up", "Child Villager", Vector2.new(0, 0))
	else
		promptTrade = createPrompt(model, "Trade", "Villager", Vector2.new(0, 0))
	end

	addHighlight(model, villagerType == "baby" and Color3.fromRGB(180, 220, 255) or RARITY_COLORS[model:GetAttribute("TopRarity") or "common"])

	if villagerType == "adult" then
		if promptTrade then
			promptTrade.Triggered:Connect(function(player)
				local data = Villagers[villagerId]
				if not data or not data.Model or not data.Model.Parent then
					return
				end
				tradeRemote:FireClient(player, "Open", {
					VillagerId = villagerId,
					VillagerName = model.Name,
					Items = items,
				})
			end)
		end
	else
		if promptPickup then
			promptPickup.Triggered:Connect(function(player)
				local data = Villagers[villagerId]
				if not data or not data.Model or not data.Model.Parent then
					return
				end
				attachCarryVillager(player, villagerId)
			end)
		end
	end

	local topRarity = model:GetAttribute("TopRarity") or "common"
	local pos = model.PrimaryPart.Position

	if villagerType == "adult" then
		if topRarity == "legendary" then
			announceToAll("Notify", {
				Message = "A legendary trade has appeared in SnowWorld!",
				Color = RARITY_COLORS.legendary,
			})
		elseif topRarity == "mythical" then
			announceToAll("Notify", {
				Message = "A mythical trade has appeared in SnowWorld!",
				Color = RARITY_COLORS.mythical,
			})
		elseif topRarity == "divine" then
			announceToAll("Divine", {
				Message = "A rare trade awaits the most promising players...",
				Color = RARITY_COLORS.divine,
				Position = pos,
			})
			makeDivineShockwave(pos)
		end
	end

	print(string.format("[VillagerTrade] Spawned %s with %d item(s) on %s", model.Name, #items, road and road:GetFullName() or "road not found"))
end

local function getSpawnSettings()
	local mods = {}
	pcall(function()
		mods = ReputationService.GetWorldModifiers() or {}
	end)

	local spawnMultiplier = tonumber(mods.SpawnMultiplier) or 1
	local capMultiplier = tonumber(mods.CapMultiplier) or 1

	local interval = BASE_SPAWN_INTERVAL / math.max(1, spawnMultiplier)
	local cap = math.floor(BASE_MAX_ACTIVE_VILLAGERS * math.max(1, capMultiplier))

	return math.max(0.25, interval), math.max(1, cap), mods
end

local function moveVillagersLightly()
	task.spawn(function()
		while true do
			if #VillagerOrder > 0 then
				local processed = 0
				local count = #VillagerOrder
				local chaosPlayer = getCivilChaosTargetPlayer()

				while processed < math.min(MOVE_BATCH_PER_TICK, count) and #VillagerOrder > 0 do
					if MovementCursor > #VillagerOrder then
						MovementCursor = 1
					end

					local villagerId = VillagerOrder[MovementCursor]
					MovementCursor += 1
					processed += 1

					local data = villagerId and Villagers[villagerId]
					if data and data.Alive and data.Model and data.Model.Parent and not data.Busy and not data.DeathQueued and not data.CarriedBy then
						local now = os.clock()
						if not data.NextMoveAt or now >= data.NextMoveAt then
							local model = data.Model
							local humanoid = model:FindFirstChildOfClass("Humanoid")
							local hrp = getModelRootPart(model)

							if humanoid and hrp then
								if chaosPlayer and chaosPlayer.Character then
									startAttackLoop(villagerId, chaosPlayer.Character, nil, true)
								else
									if not data.IsBaby then
										local priorityPlayer, priorityRep = getPriorityRepTarget()
										if priorityPlayer and priorityPlayer.Character and priorityRep <= -1000 then
											local targetRoot = getCharacterRoot(priorityPlayer.Character)
											if targetRoot and (targetRoot.Position - hrp.Position).Magnitude <= 400 then
												startAttackLoop(villagerId, priorityPlayer.Character, nil, true)
											end
										end

										local zombie = getNearestZombie(hrp.Position, ZOMBIE_DETECTION_RADIUS)
										if zombie then
											startAttackLoop(villagerId, zombie, nil, false)
										end
									end
								end

								local currentRoad = data.CurrentRoad
								if not currentRoad or not currentRoad.Parent then
									currentRoad = randomRoadPart()
								end

								local nextRoad = getDifferentRoadPart(currentRoad)
								if nextRoad then
									data.CurrentRoad = nextRoad
									local destination = getRandomPointOnRoad(nextRoad)
									if destination then
										humanoid:MoveTo(destination)
									end
								end

								local extraDelay = data.IsBaby and 1.5 or (data.IsChild and 0.75 or 0)
								data.NextMoveAt = now + math.random(2, 4) + extraDelay
							end
						end
					end

					if MovementCursor > #VillagerOrder then
						MovementCursor = 1
					end
				end
			end

			task.wait(MOVE_TICK_DELAY)
		end
	end)
end

local function hookPlayerTool(tool, player)
	if ToolConnections[tool] then
		return
	end
	if not tool:IsA("Tool") then
		return
	end

	local mode = getWeaponMode(tool.Name)
	if mode ~= "shotgun" and mode ~= "rocketlauncher" and mode ~= "classicsword" and mode ~= "machete" then
		return
	end

	ToolConnections[tool] = true

	tool.AncestryChanged:Connect(function(_, parent)
		if not parent then
			ToolConnections[tool] = nil
		end
	end)

	tool.Activated:Connect(function()
		if not player or not player.Parent then
			return
		end

		local character = player.Character
		local hrp = getCharacterRoot(character)
		if not hrp then
			return
		end

		if supportOrIgnoreOnMonsterFight(player, tool.Name, mode) then
			return
		end

		local provokeRange
		if mode == "shotgun" then
			provokeRange = 20
		elseif mode == "rocketlauncher" then
			provokeRange = 50
		elseif mode == "classicsword" or mode == "machete" then
			provokeRange = 8
		end

		if not provokeRange then
			return
		end

		local villagerId = select(1, findClosestVillagerToPosition(hrp.Position, provokeRange))
		if villagerId then
			local data = Villagers[villagerId]
			if data and data.Alive and data.Model and data.Model.Parent and not data.IsBaby then
				local rootPart = getModelRootPart(data.Model)
				markPlayerThreat(player, tool.Name, mode, villagerId, rootPart and rootPart.Position or nil)
				startAttackLoop(villagerId, character, mode, false)
			end
		end
	end)
end

local function hookContainerForTools(player, container)
	if not container then
		return
	end

	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Tool") then
			hookPlayerTool(child, player)
		end
	end

	container.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			hookPlayerTool(child, player)
		end
	end)
end

local function setupPlayer(player)
	clearPlayerThreat(player.UserId)

	local backpack = player:WaitForChild("Backpack")
	hookContainerForTools(player, backpack)

	player.CharacterAdded:Connect(function(character)
		clearPlayerThreat(player.UserId)

		local hum = character:WaitForChild("Humanoid", 10)
		if hum then
			hum.Died:Connect(function()
				releaseCarriedVillager(player, false)
			end)
		end

		hookContainerForTools(player, character)
	end)

	player.CharacterRemoving:Connect(function()
		clearPlayerThreat(player.UserId)
		releaseCarriedVillager(player, false)
	end)

	if player.Character then
		hookContainerForTools(player, player.Character)
	end
end

Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(function(player)
	clearPlayerThreat(player.UserId)
	releaseCarriedVillager(player, false)
end)

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

carryRemote.OnServerEvent:Connect(function(player, action, payload)
	if action ~= "Throw" then
		return
	end

	local state = CarryStateByPlayer[player.UserId]
	if not state or not state.VillagerId or not state.Tool then
		return
	end

	if typeof(payload) == "Vector3" then
		state.AimPosition = payload
	else
		state.AimPosition = nil
	end

	releaseCarriedVillager(player, true)
end)

tradeRemote.OnServerEvent:Connect(function(player, action, payload)
	if action ~= "Buy" then
		return
	end
	if typeof(payload) ~= "table" then
		return
	end

	local villagerId = payload.VillagerId
	local itemId = payload.ItemId
	if type(villagerId) ~= "string" or type(itemId) ~= "string" then
		return
	end

	local data = Villagers[villagerId]
	if not data or not data.Model or not data.Model.Parent then
		return
	end

	if data.IsBaby or data.IsChild then
		return
	end

	local item
	for _, info in ipairs(data.Items) do
		if info.Id == itemId then
			item = info
			break
		end
	end
	if not item then
		return
	end

	local coins = getCoinValue(player)
	if not coins then
		tradeRemote:FireClient(player, "Notify", {
			Message = "No Coins value was found on your player.",
			Color = Color3.fromRGB(255, 100, 100),
		})
		return
	end

	local discountMultiplier = 1
	local ok, mult = pcall(function()
		return ReputationService.GetDiscountMultiplier(player)
	end)
	if ok and tonumber(mult) then
		discountMultiplier = math.clamp(tonumber(mult), 0.05, 1)
	end

	local finalCost = math.max(1, math.floor((item.Cost or 1) * discountMultiplier + 0.5))

	if coins.Value < finalCost then
		tradeRemote:FireClient(player, "Notify", {
			Message = "You do not have enough coins for that trade.",
			Color = Color3.fromRGB(255, 100, 100),
		})
		return
	end

	local templateTool = data.ToolMap[itemId]
	if not templateTool or not templateTool:IsA("Tool") then
		return
	end

	coins.Value -= finalCost
	templateTool:Clone().Parent = player:WaitForChild("Backpack")

	local starterGear = player:FindFirstChildOfClass("StarterGear")
	if starterGear then
		templateTool:Clone().Parent = starterGear
	end

	for i = #data.Items, 1, -1 do
		if data.Items[i].Id == itemId then
			table.remove(data.Items, i)
			break
		end
	end
	data.ToolMap[itemId] = nil
	setVillagerRarityAttributes(data.Model, data.Items)

	pcall(function()
		ReputationService.RegisterTrade(player)
	end)

	tradeRemote:FireClient(player, "Notify", {
		Message = "Trade completed: " .. templateTool.Name .. " for " .. finalCost .. " coins.",
		Color = Color3.fromRGB(120, 255, 120),
	})
end)

task.spawn(function()
	print("[VillagerTrade] Spawn loop started.")
	moveVillagersLightly()

	while true do
		local interval, cap = getSpawnSettings()
		if #getRoadParts() > 0 then
			if getActiveVillagerCount() < cap then
				local ok, err = pcall(spawnVillager)
				if not ok then
					warn("[VillagerTrade] Spawn failed:", err)
				end
			end
		end
		task.wait(interval)
	end
end)
