local function getCharacter()
	return localPlayer.Character
end

local function getHumanoid()
	local char = getCharacter()
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function getHRP()
	local char = getCharacter()
	return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
end

local function isPlayerCharacter(model)
	return model and model:IsA("Model") and Players:GetPlayerFromCharacter(model) ~= nil
end

local function isNPCModel(model)
	if not model or not model:IsA("Model") then
		return false
	end
	if isPlayerCharacter(model) then
		return false
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

local function getRootPart(model)
	if not model then
		return nil
	end
	return model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("Torso")
end

local function getAimPosition()
	if mouse and mouse.Hit then
		return mouse.Hit.Position
	end

	local hrp = getHRP()
	if hrp then
		return hrp.Position + hrp.CFrame.LookVector * 120
	end

	local cam = Workspace.CurrentCamera
	if cam then
		return cam.CFrame.Position + cam.CFrame.LookVector * 120
	end

	return Vector3.new(0, 50, 0)
end

local function ensureTool()
	local backpack = localPlayer:FindFirstChildOfClass("Backpack")
	if not backpack then
		return nil
	end

	local existing = backpack:FindFirstChild(TOOL_NAME)
	if existing and existing:IsA("Tool") then
		return existing
	end

	local char = getCharacter()
	if char then
		local inChar = char:FindFirstChild(TOOL_NAME)
		if inChar and inChar:IsA("Tool") then
			return inChar
		end
	end

	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAME
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.Parent = backpack
	return tool
end

local function updateUIScale()
	if not uiScale or not Workspace.CurrentCamera then
		return
	end

	local v = Workspace.CurrentCamera.ViewportSize
	local shortest = math.max(320, math.min(v.X, v.Y))
	uiScale.Scale = math.clamp(shortest / 900, 0.75, 1.08)
end

local function updateUI()
	if not gui then
