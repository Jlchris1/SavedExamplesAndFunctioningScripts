	local widthAlpha = math.clamp((CONFIG.MaxLowWidth - current.bottomWidth) / math.max(CONFIG.MaxLowWidth - CONFIG.MinLowWidth, 1), 0, 1)
	local segmentCount = hugeMode and math.clamp(math.floor(40 + widthAlpha * 20), CONFIG.HugeMinSegments, CONFIG.HugeMaxSegments) or math.clamp(math.floor(160 + widthAlpha * 90), CONFIG.MinSegments, CONFIG.MaxSegments)
	local segmentFractions = table.create(segmentCount)
