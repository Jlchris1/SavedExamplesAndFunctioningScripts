	return pad
end

local function chooseNaturalSpawnPoint(rng)
	local candidates = {}

	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst:IsA("BasePart") and inst.Anchored and not inst:IsDescendantOf(TORNADO_FOLDER) and not inst:IsDescendantOf(BLOOD_FOLDER) then
			if inst.Size.X >= CONFIG.SpawnMinWideSize and inst.Size.Y >= CONFIG.SpawnMinThickness and inst.Size.Z >= CONFIG.SpawnMinWideSize then
				table.insert(candidates, inst)
			end
		end
	end

	if #candidates == 0 then
		local pad = getOrCreateSpawnPad()
		if pad.Size.X < CONFIG.SpawnMinWideSize or pad.Size.Z < CONFIG.SpawnMinWideSize then
			pad.Size = Vector3.new(1000, 0.001, 1000)
		end
		return pad.Position + Vector3.new(rng:NextNumber(-100, 100), 10, rng:NextNumber(-100, 100))
	end

	local part = candidates[rng:NextInteger(1, #candidates)]
	local halfX = math.max(part.Size.X * 0.5 - 50, 1)
	local halfZ = math.max(part.Size.Z * 0.5 - 50, 1)

	local localX = rng:NextNumber(-halfX, halfX)
	local localZ = rng:NextNumber(-halfZ, halfZ)
	local localY = part.Size.Y * 0.5 + 10

	local worldPoint = part.CFrame:PointToWorldSpace(Vector3.new(localX, localY, localZ))

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.IgnoreWater = true
	params.FilterDescendantsInstances = { TORNADO_FOLDER, BLOOD_FOLDER }

	local result = Workspace:Raycast(worldPoint + Vector3.new(0, 2000, 0), Vector3.new(0, -5000, 0), params)
	if result and result.Position then
		return result.Position
	end

	return worldPoint
end

local function probeShelterExposure(characterModel, rootPart)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.IgnoreWater = true
	params.FilterDescendantsInstances = { characterModel, TORNADO_FOLDER, BLOOD_FOLDER }

	local origin = rootPart.Position + Vector3.new(0, 2, 0)
	local directions = {
		Vector3.new(1, 0, 0),
		Vector3.new(-1, 0, 0),
		Vector3.new(0, 0, 1),
		Vector3.new(0, 0, -1),
		Vector3.new(1, 0, 1).Unit,
		Vector3.new(1, 0, -1).Unit,
		Vector3.new(-1, 0, 1).Unit,
		Vector3.new(-1, 0, -1).Unit,
		Vector3.new(0, 1, 0),
	}

	local maxDist = 80
	local bestDir = Vector3.new(1, 0, 0)
	local bestDist = -1
	local blockedCount = 0
	local totalDist = 0

	for _, dir in ipairs(directions) do
		local result = Workspace:Raycast(origin, dir * maxDist, params)
		local dist = result and (result.Position - origin).Magnitude or maxDist
		totalDist += dist

		if dist > bestDist then
			bestDist = dist
			bestDir = dir
		end

		if dist < 12 then
			blockedCount += 1
		end
	end

	local avgOpen = totalDist / #directions
	local enclosed = blockedCount >= 6 and avgOpen < 24
	local gapOpen = bestDist >= 28

	return {
		Enclosed = enclosed,
		GapOpen = gapOpen,
		GapDir = bestDir,
		GapDistance = bestDist,
		AvgOpen = avgOpen,
	}
end

local function scheduleThrownDestroy(inst)
	if inst and inst.Parent and not inst:GetAttribute("TornadoDestroyScheduled") then
		inst:SetAttribute("TornadoDestroyScheduled", true)
		Debris:AddItem(inst, CONFIG.DestroyThrownPartDelay)
	end
end

local function registerStorm(storm)
	activeStorms[storm.id] = storm
end

local function unregisterStorm(storm)
	if storm and storm.id then
		activeStorms[storm.id] = nil
	end
end

local function destroyStorm(storm)
	if not storm or storm.destroyed then
		return
	end
	storm.destroyed = true
	unregisterStorm(storm)
	if storm.model and storm.model.Parent then
		storm.model:Destroy()
	end
end

local function getStormById(id)
	return activeStorms[id]
end

local function isHugeTornado(base)
	return math.max(base.bottomWidth or 0, base.topWidth or 0) > 2048
end

local function absorbStormIntoSurvivor(survivor, loser)
	if not survivor or not loser or survivor.destroyed or loser.destroyed then
		return
	end

	local combinedMph = math.max(survivor.base.mph, loser.base.mph) * 1.14 + math.min(survivor.base.mph, loser.base.mph) * 0.18
	local combinedBottom = math.max(survivor.base.bottomWidth, loser.base.bottomWidth) * 1.18
	local combinedTop = math.max(survivor.base.topWidth, loser.base.topWidth) * 1.22
	local combinedWind = math.max(survivor.base.windField, loser.base.windField) * 1.35 + math.min(survivor.base.windField, loser.base.windField) * 0.25
	local combinedPull = math.max(survivor.base.pullZone, loser.base.pullZone) * 1.25 + math.min(survivor.base.pullZone, loser.base.pullZone) * 0.2
	local combinedAxis = math.max(survivor.base.axisClimb, loser.base.axisClimb) * 1.12
	local combinedRope = math.max(survivor.base.ropeyness, loser.base.ropeyness) * 1.08
	local combinedLifetime = math.max(survivor.base.lifetime, loser.base.lifetime) + 180

	survivor.base.mph = math.clamp(combinedMph, 40, 500)
	survivor.base.bottomWidth = math.clamp(combinedBottom, CONFIG.MinLowWidth, CONFIG.MaxLowWidth)
	survivor.base.topWidth = math.clamp(combinedTop, math.max(survivor.base.bottomWidth * 3, CONFIG.MinTopWidth), CONFIG.MaxTopWidth)
	survivor.base.windField = math.clamp(combinedWind, 50, 5000)
	survivor.base.pullZone = math.clamp(combinedPull, 25, survivor.base.windField)
	survivor.base.axisClimb = math.clamp(combinedAxis, 20, 220)
	survivor.base.ropeyness = math.clamp(combinedRope, 0.12, 3.0)
	survivor.base.lifetime = math.clamp(combinedLifetime, 120, 2400)

	survivor.current.mph = survivor.base.mph
	survivor.current.bottomWidth = survivor.base.bottomWidth
	survivor.current.topWidth = survivor.base.topWidth
	survivor.current.windField = survivor.base.windField
	survivor.current.pullZone = survivor.base.pullZone
	survivor.current.axisClimb = survivor.base.axisClimb
	survivor.current.ropeyness = survivor.base.ropeyness

	survivor.strength = math.clamp((survivor.strength or 1) + 0.55, 0.8, 2.5)
	survivor.strengthTarget = math.clamp((survivor.strengthTarget or 1) + 0.35, 0.9, 2.8)
	survivor.deathTime = math.max(survivor.deathTime or 0, os.clock() + 120)

	if survivor.root and loser.root then
		survivor.root.Position = (survivor.root.Position + loser.root.Position) * 0.5
	end
end

local function endStormDuelWithRelease(a, b, duel)
	if not a or not b or not duel or duel.resolved then
		return
	end
	duel.resolved = true

	local awayA = safeUnit(a.root.Position - b.root.Position)
	local awayB = -awayA
	if awayA == Vector3.zero then
		awayA = randomFlatDirection(a.rng)
	end
	if awayB == Vector3.zero then
		awayB = -awayA
	end

	local preA = duel.preOrbitSpeedA or a.current.moveSpeed or 40
	local preB = duel.preOrbitSpeedB or b.current.moveSpeed or 40
	local dirA = safeUnit(duel.preOrbitDirA or awayA)
	local dirB = safeUnit(duel.preOrbitDirB or awayB)

	if dirA == Vector3.zero then
		dirA = awayA
	end
	if dirB == Vector3.zero then
		dirB = awayB
	end

	a.launchVelocity = safeUnit((awayA * 0.8) + (dirA * 0.2)) * math.max(preA, 40)
	b.launchVelocity = safeUnit((awayB * 0.8) + (dirB * 0.2)) * math.max(preB, 40)

	a.duel = nil
	b.duel = nil
	a.duelSide = nil
	b.duelSide = nil
end

local function endStormDuelWithMerge(a, b, duel)
	if not a or not b or not duel or duel.resolved then
		return
	end
	duel.resolved = true

	local survivor = a
	local loser = b
	if (b.current.windField or 0) > (a.current.windField or 0) or (b.current.topWidth or 0) > (a.current.topWidth or 0) then
		survivor = b
		loser = a
	end

	absorbStormIntoSurvivor(survivor, loser)

	if a then
		a.duel = nil
		a.duelSide = nil
	end
	if b then
		b.duel = nil
		b.duelSide = nil
	end

	destroyStorm(loser)
end

local function beginStormDuel(a, b, t)
	if not a or not b or a.destroyed or b.destroyed then
		return
	end
	if a.duel or b.duel then
		return
	end

	local duel = {
		partnerIdA = a.id,
		partnerIdB = b.id,
		startedAt = t,
		resolveAt = t + a.rng:NextNumber(2.5, 6.5),
		chaos = 0,
		resolved = false,
		preOrbitSpeedA = math.max((a.rootVelocity and a.rootVelocity.Magnitude) or 0, a.current.moveSpeed or 0),
		preOrbitSpeedB = math.max((b.rootVelocity and b.rootVelocity.Magnitude) or 0, b.current.moveSpeed or 0),
		preOrbitDirA = safeUnit(a.rootVelocity),
		preOrbitDirB = safeUnit(b.rootVelocity),
		initialDistance = (a.root.Position - b.root.Position).Magnitude,
	}

	a.duel = duel
	b.duel = duel
	a.duelSide = 1
	b.duelSide = -1
	a.launchVelocity = a.launchVelocity or Vector3.zero
	b.launchVelocity = b.launchVelocity or Vector3.zero
end

local function findInteractionPartner(storm)
	local best
	local bestDist = math.huge

	for _, other in pairs(activeStorms) do
		if other ~= storm and other and other.model and other.model.Parent and not other.destroyed then
			if not other.duel and (storm.id < other.id) then
				local dist = (storm.root.Position - other.root.Position).Magnitude
				local fieldRadius = math.max(storm.current.windField or 0, other.current.windField or 0)
				local widthRadius = math.max(storm.current.topWidth or 0, other.current.topWidth or 0)
				local triggerRadius = math.max(fieldRadius * 0.72, 650) + widthRadius * 0.15
				if dist <= triggerRadius and dist < bestDist then
					best = other
					bestDist = dist
				end
			end
		end
	end

	return best
end

local function makeCloudPlates(parent)
	local plates = {}
	local index = 1

	for gx = -CONFIG.CloudGridRadius, CONFIG.CloudGridRadius do
		for gz = -CONFIG.CloudGridRadius, CONFIG.CloudGridRadius do
			local dist = math.sqrt(gx * gx + gz * gz)
			if dist <= CONFIG.CloudGridRadius + 0.35 then
				local plate = Instance.new("Part")
				plate.Name = "TopCloudPlate"
				plate.Anchored = true
				plate.CanCollide = false
				plate.CanTouch = false
				plate.CanQuery = false
				plate.Material = Enum.Material.SmoothPlastic
				plate.Color = Color3.fromRGB(170, 170, 170)
				plate.Transparency = 1
				plate.Size = Vector3.new(2048, 0.3, 2048)
				plate.Parent = parent
				plate:SetAttribute("CloudGX", gx)
				plate:SetAttribute("CloudGZ", gz)
				plate:SetAttribute("CloudSpacing", CONFIG.CloudGridSpacing)
				plates[index] = plate
				index += 1
			end
		end
	end

	return plates
end

local function spawnTornado(origin, settings)
	local rng = Random.new(math.floor(os.clock() * 1000000) % 2147483647)

