local function safeUnit(v)
	if v.Magnitude < 0.001 then
		return Vector3.zero
	end
	return v.Unit
end

local function clampVectorMagnitude(v, maxMag)
	local mag = v.Magnitude
	if mag <= maxMag then
		return v
	end
	if mag < 0.001 then
		return Vector3.zero
	end
	return v.Unit * maxMag
end

local function randomFlatDirection(rng)
	local a = rng:NextNumber(0, math.pi * 2)
	return Vector3.new(math.cos(a), 0, math.sin(a))
end

local function randomSphereDirection(rng)
	local dir = Vector3.new(
		rng:NextNumber(-1, 1),
		rng:NextNumber(-1, 1),
		rng:NextNumber(-1, 1)
	)
	if dir.Magnitude < 0.001 then
		return Vector3.new(0, 1, 0)
	end
	return dir.Unit
end

local function projectOntoPlane(v, normal)
	return v - normal * v:Dot(normal)
end

local function buildOrbitBasis(axisDir, previousBasis1, referenceVector)
	local axis = safeUnit(axisDir)
	if axis == Vector3.zero then
		axis = WORLD_UP
	end

	local basis1 = Vector3.zero
	if previousBasis1 then
		basis1 = projectOntoPlane(previousBasis1, axis)
	end

	if basis1.Magnitude < 0.001 then
		basis1 = projectOntoPlane(referenceVector, axis)
	end

	if basis1.Magnitude < 0.001 then
		local helper = Vector3.new(1, 0, 0)
		if math.abs(axis:Dot(helper)) > 0.92 then
			helper = Vector3.new(0, 0, 1)
		end
		basis1 = helper:Cross(axis)
	end

	if basis1.Magnitude < 0.001 then
		basis1 = Vector3.new(0, 1, 0):Cross(axis)
	end

	if basis1.Magnitude < 0.001 then
		basis1 = Vector3.new(1, 0, 0)
	end

	basis1 = basis1.Unit

	local basis2 = axis:Cross(basis1)
	if basis2.Magnitude < 0.001 then
		basis2 = Vector3.new(0, 0, 1)
	end
	basis2 = basis2.Unit

	return basis1, basis2
end

local function frameFromDirection(pos, upDir)
	local up = safeUnit(upDir)
	if up == Vector3.zero then
		up = WORLD_UP
	end

	local helper = Vector3.new(1, 0, 0)
	if math.abs(up:Dot(helper)) > 0.92 then
		helper = Vector3.new(0, 0, 1)
	end

	local right = helper:Cross(up)
	if right.Magnitude < 0.001 then
		helper = Vector3.new(0, 0, 1)
		right = helper:Cross(up)
	end

	right = right.Unit
	local back = right:Cross(up).Unit
	return CFrame.fromMatrix(pos, right, up, back)
end

local function isInsideWhitelistedFolder(inst)
	local current = inst
	while current do
		if current:IsA("Folder") and current.Name == "Whitelisted" then
			return true
		end
		current = current.Parent
	end
	return false
end

local function isMassiveStructurePart(part)
	local s = part.Size
	local dims = { s.X, s.Y, s.Z }
	table.sort(dims)
	return dims[3] >= 1500 and dims[1] <= 1 and dims[2] >= 750
end

local function shouldIgnoreWindPart(part)
	if not part or not part.Parent then
		return true
	end
	if part:IsDescendantOf(TORNADO_FOLDER) then
		return true
	end
	if part:IsDescendantOf(BLOOD_FOLDER) then
		return true
	end
	if isInsideWhitelistedFolder(part) then
		return true
	end
	if isMassiveStructurePart(part) then
		return true
	end
	return false
end

local function getCharacterModelFromRoot(rootPart)
	local model = rootPart:FindFirstAncestorOfClass("Model")
	if not model then
		return nil, nil
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		return model, humanoid
	end

	return model, nil
end

local function getGroundYAtPosition(pos, modelToIgnore)
	local rayOrigin = Vector3.new(pos.X, pos.Y + GROUND_RAY_HEIGHT, pos.Z)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.IgnoreWater = true

	local blacklist = { TORNADO_FOLDER, BLOOD_FOLDER }
	if modelToIgnore then
		table.insert(blacklist, modelToIgnore)
	end
	params.FilterDescendantsInstances = blacklist

	local result = Workspace:Raycast(rayOrigin, Vector3.new(0, -GROUND_RAY_DEPTH, 0), params)
	if result and result.Position then
		return result.Position.Y, result.Instance
	end

	return nil, nil
end

local function setCharacterTornadoFreeze(characterModel, humanoid, enabled)
	if not characterModel or not humanoid or humanoid.Health <= 0 then
		return
	end

	if enabled then
		if frozenCharacters[characterModel] then
			return
		end

		frozenCharacters[characterModel] = true
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false

		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)

		local animate = characterModel:FindFirstChild("Animate")
		if animate and animate:IsA("LocalScript") then
			pcall(function()
				animate.Disabled = true
			end)
		end
	else
		if not frozenCharacters[characterModel] then
			return
		end

		frozenCharacters[characterModel] = nil
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true

		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)

		local animate = characterModel:FindFirstChild("Animate")
		if animate and animate:IsA("LocalScript") then
			pcall(function()
				animate.Disabled = false
			end)
		end
	end
end

local function ragdollCharacterOnDeath(characterModel)
	if ragdolledModels[characterModel] then
		return
	end

	local humanoid = characterModel:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	ragdolledModels[characterModel] = true
	frozenCharacters[characterModel] = nil

	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.AutoRotate = false
	humanoid.PlatformStand = false

	pcall(function()
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end)

	local ragdollFolder = characterModel:FindFirstChild("TornadoRagdollConstraints")
	if not ragdollFolder then
		ragdollFolder = Instance.new("Folder")
		ragdollFolder.Name = "TornadoRagdollConstraints"
		ragdollFolder.Parent = characterModel
	end

	for _, inst in ipairs(characterModel:GetDescendants()) do
		if inst:IsA("BasePart") then
			inst.CanCollide = inst.Name ~= "HumanoidRootPart"
			inst.Massless = false
		end
	end

	for _, inst in ipairs(characterModel:GetDescendants()) do
		if inst:IsA("Motor6D") then
			local part0 = inst.Part0
			local part1 = inst.Part1

			if part0 and part1 then
				local att0 = Instance.new("Attachment")
				att0.Name = "TornadoRagdollAtt0"
				att0.CFrame = inst.C0
				att0.Parent = part0

				local att1 = Instance.new("Attachment")
				att1.Name = "TornadoRagdollAtt1"
				att1.CFrame = inst.C1
				att1.Parent = part1

				local socket = Instance.new("BallSocketConstraint")
				socket.Name = "TornadoRagdollSocket"
				socket.Attachment0 = att0
				socket.Attachment1 = att1
				socket.LimitsEnabled = true
				socket.TwistLimitsEnabled = true
				socket.UpperAngle = 45
				socket.TwistLowerAngle = -45
				socket.TwistUpperAngle = 45
				socket.MaxFrictionTorque = 10
				socket.Parent = ragdollFolder
			end

			pcall(function()
				inst.Enabled = false
			end)
			inst:Destroy()
		end
	end
end

local function spawnBloodSplatter(position)
	local folder = Instance.new("Folder")
	folder.Name = "FakeBlood"
	folder.Parent = BLOOD_FOLDER

	local rng = Random.new(math.floor(os.clock() * 1000000) % 2147483647)

	for _ = 1, 80 do
		local p = Instance.new("Part")
		p.Name = "BloodBrick"
		p.Size = Vector3.new(1, 0.5, 1)
		p.Material = Enum.Material.SmoothPlastic
		p.Color = Color3.fromRGB(170, 0, 0)
		p.Transparency = rng:NextNumber(0.15, 0.45)
		p.Anchored = false
		p.CanCollide = true
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth

		local outward = randomSphereDirection(rng)
		local spawnOffset = outward * rng:NextNumber(0.25, 2.25)

		p.CFrame =
			CFrame.new(position + spawnOffset)
			* CFrame.Angles(
				rng:NextNumber(0, math.pi * 2),
				rng:NextNumber(0, math.pi * 2),
				rng:NextNumber(0, math.pi * 2)
			)

		p.Parent = folder

		local speed = rng:NextNumber(45, 110)
		p.AssemblyLinearVelocity = outward * speed + Vector3.new(0, rng:NextNumber(10, 35), 0)
		p.AssemblyAngularVelocity = Vector3.new(
			rng:NextNumber(-14, 14),
			rng:NextNumber(-14, 14),
			rng:NextNumber(-14, 14)
		)

		Debris:AddItem(p, 10)
	end

	Debris:AddItem(folder, 10.15)
end

